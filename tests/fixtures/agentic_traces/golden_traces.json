{
  "schema": "hipengine.agentic_traces.v1",
  "traces": [
    {
      "name": "tool_loop_turn_1_non_streaming",
      "kind": "http",
      "endpoint": "/v1/chat/completions",
      "fake_outputs": [
        "<tool_call>{\"name\":\"read\",\"arguments\":{\"path\":\"README.md\"}}</tool_call>"
      ],
      "request": {
        "model": "fake-model",
        "messages": [{"role": "user", "content": "Read the README."}],
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "read",
              "description": "Read a file",
              "parameters": {"type": "object"}
            }
          }
        ]
      },
      "expected": {
        "status_code": 200,
        "finish_reason": "tool_calls",
        "message_content": "",
        "tool_call": {"name": "read", "arguments": {"path": "README.md"}},
        "prompt_contains": ["<tools>", "\"name\":\"read\""]
      }
    },
    {
      "name": "tool_loop_turn_2_non_streaming_final_answer",
      "kind": "http",
      "endpoint": "/v1/chat/completions",
      "fake_outputs": ["The README says hello."],
      "request": {
        "model": "fake-model",
        "messages": [
          {"role": "user", "content": "Read the README."},
          {
            "role": "assistant",
            "content": null,
            "tool_calls": [
              {
                "id": "call_1",
                "type": "function",
                "function": {"name": "read", "arguments": "{\"path\":\"README.md\"}"}
              }
            ]
          },
          {"role": "tool", "tool_call_id": "call_1", "content": "hello"}
        ],
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "read",
              "description": "Read a file",
              "parameters": {"type": "object"}
            }
          }
        ]
      },
      "expected": {
        "status_code": 200,
        "finish_reason": "stop",
        "message_content": "The README says hello.",
        "prompt_contains": ["<tool_response>\nhello\n</tool_response>"]
      }
    },
    {
      "name": "reasoning_tool_call_non_streaming",
      "kind": "http",
      "endpoint": "/v1/chat/completions",
      "fake_outputs": [
        "<think>need file</think><tool_call>{\"name\":\"read\",\"arguments\":{\"path\":\"README.md\"}}</tool_call>"
      ],
      "request": {
        "model": "fake-model",
        "messages": [{"role": "user", "content": "Read after thinking."}],
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "read",
              "description": "Read a file",
              "parameters": {
                "type": "object",
                "properties": {"path": {"type": "string"}},
                "required": ["path"],
                "additionalProperties": false
              },
              "strict": true
            }
          }
        ]
      },
      "expected": {
        "status_code": 200,
        "finish_reason": "tool_calls",
        "finish_details": {
          "reason": "tool_calls",
          "phase": "tool_call",
          "reasoning_tokens": 2,
          "tool_call_tokens": 1
        },
        "message_content": "",
        "reasoning_content": "need file",
        "tool_call": {"name": "read", "arguments": {"path": "README.md"}},
        "response_excludes": ["<tool_call>"]
      }
    },
    {
      "name": "strict_malformed_tool_call_non_streaming",
      "kind": "http",
      "endpoint": "/v1/chat/completions",
      "fake_outputs": [
        "<tool_call>\n<tool_call>{\"name\":\"read\",\"arguments\":{\"path\":\"README.md\"}}</tool_call>"
      ],
      "request": {
        "model": "fake-model",
        "messages": [{"role": "user", "content": "Read strictly."}],
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "read",
              "description": "Read a file",
              "parameters": {
                "type": "object",
                "properties": {"path": {"type": "string"}},
                "required": ["path"],
                "additionalProperties": false
              },
              "strict": true
            }
          }
        ]
      },
      "expected": {
        "status_code": 200,
        "finish_reason": "stop",
        "finish_details": {"reason": "invalid_tool_call"},
        "message_content": "",
        "no_tool_calls": true,
        "response_excludes": ["<tool_call>"]
      }
    },
    {
      "name": "tool_call_streaming",
      "kind": "http",
      "endpoint": "/v1/chat/completions",
      "fake_stream_chunks": [
        "<tool_call>{\"name\":\"bash\",\"arguments\":{\"command\":\"pwd\"}}</tool_call>"
      ],
      "request": {
        "model": "fake-model",
        "messages": [{"role": "user", "content": "Run pwd."}],
        "stream": true,
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "bash",
              "description": "Run a command",
              "parameters": {"type": "object"}
            }
          }
        ]
      },
      "expected": {
        "status_code": 200,
        "finish_reason": "tool_calls",
        "tool_call": {"name": "bash", "arguments": {"command": "pwd"}}
      }
    },
    {
      "name": "reasoning_tool_call_streaming",
      "kind": "http",
      "endpoint": "/v1/chat/completions",
      "fake_stream_chunks": [
        "<think>need shell</think><tool_call>{\"name\":\"bash\",\"arguments\":{\"command\":\"pwd\"}}</tool_call>"
      ],
      "request": {
        "model": "fake-model",
        "messages": [{"role": "user", "content": "Think, then run pwd."}],
        "stream": true,
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "bash",
              "description": "Run a command",
              "parameters": {
                "type": "object",
                "properties": {"command": {"type": "string"}},
                "required": ["command"],
                "additionalProperties": false
              },
              "strict": true
            }
          }
        ]
      },
      "expected": {
        "status_code": 200,
        "finish_reason": "tool_calls",
        "finish_details": {
          "reason": "tool_calls",
          "phase": "tool_call",
          "reasoning_tokens": 2,
          "tool_call_tokens": 1
        },
        "reasoning_content": "need shell",
        "tool_call": {"name": "bash", "arguments": {"command": "pwd"}},
        "response_excludes": ["<tool_call>"]
      }
    },
    {
      "name": "parallel_tool_calls_streaming",
      "kind": "http",
      "endpoint": "/v1/chat/completions",
      "fake_stream_chunks": [
        "<tool_call>{\"name\":\"read\",\"arguments\":{\"path\":\"README.md\"}}</tool_call><tool_call>{\"name\":\"read\",\"arguments\":{\"path\":\"WORKLOG.md\"}}</tool_call>"
      ],
      "request": {
        "model": "fake-model",
        "messages": [{"role": "user", "content": "Read both files."}],
        "stream": true,
        "parallel_tool_calls": true,
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "read",
              "description": "Read a file",
              "parameters": {
                "type": "object",
                "properties": {"path": {"type": "string"}},
                "required": ["path"],
                "additionalProperties": false
              },
              "strict": true
            }
          }
        ]
      },
      "expected": {
        "status_code": 200,
        "finish_reason": "tool_calls",
        "finish_details": {
          "reason": "tool_calls",
          "phase": "tool_call",
          "tool_call_tokens": 2
        },
        "tool_calls": [
          {"index": 0, "name": "read", "arguments": {"path": "README.md"}},
          {"index": 1, "name": "read", "arguments": {"path": "WORKLOG.md"}}
        ],
        "response_excludes": ["<tool_call>"]
      }
    },
    {
      "name": "reasoning_split_non_streaming",
      "kind": "http",
      "endpoint": "/v1/chat/completions",
      "fake_outputs": ["<think>scratch pad</think>visible answer"],
      "request": {
        "model": "fake-model",
        "messages": [{"role": "user", "content": "Think briefly."}]
      },
      "expected": {
        "status_code": 200,
        "finish_reason": "stop",
        "message_content": "visible answer",
        "reasoning_content": "scratch pad"
      }
    },
    {
      "name": "no_think_prompt_rendering",
      "kind": "http",
      "endpoint": "/v1/chat/completions",
      "fake_outputs": ["direct answer"],
      "request": {
        "model": "fake-model",
        "messages": [{"role": "user", "content": "Answer directly."}],
        "enable_thinking": false
      },
      "expected": {
        "status_code": 200,
        "message_content": "direct answer",
        "prompt_endswith": "<|im_start|>assistant\n<think>\n\n</think>\n\n"
      }
    },
    {
      "name": "reasoning_effort_low_prompt_budget",
      "kind": "http",
      "endpoint": "/v1/chat/completions",
      "fake_outputs": ["direct answer"],
      "request": {
        "model": "fake-model",
        "messages": [{"role": "user", "content": "Think only if needed."}],
        "reasoning": {"enabled": true, "effort": "low"},
        "max_tokens": 2048
      },
      "expected": {
        "status_code": 200,
        "finish_reason": "stop",
        "message_content": "direct answer",
        "prompt_contains": [
          "close </think> before exceeding 512 hidden reasoning tokens",
          "reserve at least 512 tokens for the final answer or tool call",
          "begin closing during the final 128 hidden reasoning tokens"
        ],
        "prompt_excludes": ["<tools>"]
      }
    },
    {
      "name": "json_schema_violation_chat",
      "kind": "http",
      "endpoint": "/v1/chat/completions",
      "fake_outputs": ["{\"ok\":\"yes\",\"path\":\"README.md\"}"],
      "request": {
        "model": "fake-model",
        "messages": [{"role": "user", "content": "Return structured output."}],
        "response_format": {
          "type": "json_schema",
          "json_schema": {
            "name": "agent_result",
            "schema": {
              "type": "object",
              "properties": {
                "ok": {"type": "boolean"},
                "path": {"type": "string", "minLength": 1}
              },
              "required": ["ok", "path"],
              "additionalProperties": false
            }
          }
        }
      },
      "expected": {
        "status_code": 200,
        "finish_reason": "stop",
        "finish_details": {"reason": "schema_violation"},
        "message_content": "",
        "prompt_contains": ["Return only JSON that satisfies this JSON schema"]
      }
    },
    {
      "name": "stateless_session_append_none_completion",
      "kind": "http",
      "endpoint": "/v1/completions",
      "fake_outputs": ["stateless answer"],
      "request": {
        "model": "fake-model",
        "prompt": "answer without retaining",
        "session": {"commit": "append_none"}
      },
      "expected": {
        "status_code": 200,
        "finish_reason": "stop",
        "text": "stateless answer",
        "finish_details": {"reason": "stop", "cache_action": "append_none"}
      }
    },
    {
      "name": "length_finish_completion",
      "kind": "http",
      "endpoint": "/v1/completions",
      "fake_detailed_outputs": [
        {"text": "partial", "finish_details": {"reason": "length", "length_limit": 1}}
      ],
      "request": {
        "model": "fake-model",
        "prompt": "cut short",
        "max_tokens": 1
      },
      "expected": {
        "status_code": 200,
        "finish_reason": "length",
        "text": "partial",
        "finish_details": {"reason": "length", "length_limit": 1}
      }
    },
    {
      "name": "deadline_error_completion",
      "kind": "http",
      "endpoint": "/v1/completions",
      "fake_outputs": ["late"],
      "generate_delay_s": 0.03,
      "request": {
        "model": "fake-model",
        "prompt": "slow",
        "max_tokens": 1,
        "timeout_ms": 1
      },
      "expected": {
        "status_code": 408,
        "error_code": "deadline_exceeded",
        "hipengine_error_code": "deadline_exceeded",
        "finish_details": {"reason": "deadline_exceeded", "deadline_exceeded": true}
      }
    },
    {
      "name": "unsupported_continuation_id_chat",
      "kind": "http",
      "endpoint": "/v1/chat/completions",
      "request": {
        "model": "fake-model",
        "messages": [{"role": "user", "content": "Continue previous work."}],
        "continuation_id": "gen_123"
      },
      "expected": {
        "status_code": 400,
        "error_code": "unsupported_parameter",
        "error_param": "continuation_id",
        "hipengine_error_code": "unsupported_parameter"
      }
    },
    {
      "name": "request_control_cancelled",
      "kind": "request_control_cancelled",
      "expected": {
        "status_code": 499,
        "error_code": "cancelled",
        "finish_details": {"reason": "cancelled", "cancelled": true}
      }
    }
  ]
}
