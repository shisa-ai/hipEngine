# The pre-Worklog2 journal is byte-frozen. Fail closed rather than union-merging
# an append from a branch created before the Worklog2 cutoff. Preserve its
# historical whitespace exactly without failing current diff checks.
WORKLOG-LEGACY.md -merge -whitespace

hipengine/kernels/hip_gfx1100/attention/aotriton_runtime/** -whitespace
hipengine/kernels/hip_gfx1100/attention/aotriton_runtime/**/*.aks2 filter=lfs diff=lfs merge=lfs -text
hipengine/kernels/hip_gfx1100/attention/aotriton_runtime/**/*.so* filter=lfs diff=lfs merge=lfs -text

# Unified diffs encode blank context lines as one leading space. Do not flag
# that patch syntax as trailing whitespace when the reproducibility bundle is
# added or reviewed.
benchmarks/llama.cpp/*.patch -whitespace

# Cleanup-audit decisions: one JSON object per line. Concurrent agents triage
# different rows of one file; keep both sides and let `load_triage` choose the
# most recently reviewed copy of any id that appears twice.
audit/triage/*.jsonl merge=union
audit/triage/archive/*.jsonl merge=union
