          "expression"
        ],
        "type": "object"
      },
      "strict": true
    },
    {
      "description": "Normalize or validate one nested alert record; include_metadata is optional.",
      "name": "transform_record",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "include_metadata": {
            "type": "boolean"
          },
          "mode": {
            "enum": [
              "normalize",
              "validate"
            ],
            "type": "string"
          },
          "record": {
            "additionalProperties": false,
            "properties": {
              "priority": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "station": {
                "minLength": 1,
                "type": "string"
              },
              "tags": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 6,
                "type": "array"
              }
            },
            "required": [
              "station",
              "priority",
              "tags"
            ],
            "type": "object"
          }
        },
        "required": [
          "record",
          "mode"
        ],
        "type": "object"
      },
      "strict": true
    },
    {
      "description": "Apply one declared exact one-region patch to an isolated synthetic repository copy.",
      "name": "apply_patch",
      "parameters": {
        "additionalProperties": false,
