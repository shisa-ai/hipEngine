  "diagnostic_source": "\"\"\"Read-only diagnostic: strict/split layer snapshots on identical chain.\"\"\"\nimport json\nfrom pathlib import Path\nimport numpy as np\nfrom scripts.gemma4_teacher_forced_gate import _load_chain, force_slices, _provenance, row_kl_divergence as row_kl\nfrom scripts.gemma4_campaign_bench import DEFAULT_ARTIFACT\nfrom hipengine.core.memory import copy_device_to_host, host_array_ptr\nimport hipengine.runtime.gemma4 as runtime\n\n\ndef read(buffer, count, dtype):\n    out = np.empty(count, dtype=dtype)\n    copy_device_to_host(host_array_ptr(out), buffer, out.nbytes)\n    return out\n\n\ndef capture(slices):\n    force_slices(1 if slices == 'current-only' else slices)\n    runner, ids, loading = _load_chain(DEFAULT_ARTIFACT, 2048, 8192)\n    runner.reset()\n    snapshots = {}\n    original = runtime.gemma4_layer_forward_bf16\n    layer_indices = {id(s): i for i, s in enumerate(runner._scratches)}\n    def traced(*args, **kwargs):\n        result = original(*args, **kwargs)\n        pos = kwargs['kv'].write_offset\n        if kwargs['rows'] == 1 and 1886 <= pos <= 1890:\n            scratch = kwargs['scratch']\n            prefix = f'{pos}_{layer_indices[id(scratch)]}'\n            for name in ('context', 'attn_out', 'hidden', 'dense', 'experts'):\n                count = scratch.num_heads * scratch.head_dim if name == 'context' else scratch.hidden_size\n                snapshots[f'{prefix}_{name}'] = read(scratch.buffer(name), count, np.uint16)\n            snapshots[f'{prefix}_output'] = read(runner._hidden, scratch.hidden_size, np.uint16)\n            snapshots[f'{prefix}_selected'] = read(scratch.buffer('selected'), scratch.top_k, np.int64)\n            snapshots[f'{prefix}_routing'] = read(scratch.buffer('routing'), scratch.top_k, np.float32)\n        return result\n    runtime.gemma4_layer_forward_bf16 = traced\n    try:\n        runner.forward(ids[:1024])\n        for pos in range(1024, 1891):\n            if slices == 'current-only':\n                force_slices(None if pos == 1888 else 1)\n            logits = runner.forward([ids[pos]])\n            if pos >= 1886:\n                snapshots[f'{pos}_logits'] = logits.copy()\n        snapshots['ids'] = np.asarray(ids)\n    finally:\n        runtime.gemma4_layer_forward_bf16 = original\n        runner.close()\n        force_slices(None)\n    np.savez(f'/tmp/gemma4-iter50-trace-{slices}.npz', **snapshots)\n    return snapshots\n\nif __name__ == '__main__':\n    import sys\n    if len(sys.argv) > 1:\n        capture(None if sys.argv[1] == 'split' else ('current-only' if sys.argv[1] == 'current-only' else 1))\n        raise SystemExit(0)\n    strict = dict(np.load('/tmp/gemma4-iter50-trace-1.npz'))\n    split = dict(np.load('/tmp/gemma4-iter50-trace-None.npz'))\n    def bf16(a):\n        return (a.astype(np.uint32) << 16).view(np.float32)\n    results = []\n    for pos in range(1886,1891):\n        layers = []\n        for i in range(30):\n            prefix = f'{pos}_{i}'\n            row = {'layer': i}\n            for name in ('context', 'attn_out', 'hidden', 'dense', 'experts', 'output'):\n                a,b = strict[f'{prefix}_{name}'], split[f'{prefix}_{name}']\n                row[name] = {'changed':int(np.count_nonzero(a!=b)), 'max_abs':float(np.max(np.abs(bf16(a)-bf16(b))))}\n            row['strict_selected'] = strict[f'{prefix}_selected'].tolist()\n            row['split_selected'] = split[f'{prefix}_selected'].tolist()\n            row['route_set_changed'] = set(row['strict_selected']) != set(row['split_selected'])\n            row['routing_max_abs'] = float(np.max(np.abs(strict[f'{prefix}_routing']-split[f'{prefix}_routing'])))\n            layers.append(row)\n        results.append({'position':pos,'scored_row':pos-1024,'kl':row_kl(strict[f'{pos}_logits'], split[f'{pos}_logits']), 'layers':layers})\n    Path('/tmp/gemma4-iter50-trace.json').write_text(json.dumps(results, indent=2)+'\\n')\n    for row in results:\n        print(row['position'], row['kl'], 'route_changes', [x['layer'] for x in row['layers'] if x['route_set_changed']], flush=True)\n",
