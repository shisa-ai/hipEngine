diff --git a/scripts/qwen4exp_q51_lds_screen.py b/scripts/qwen4exp_q51_lds_screen.py
new file mode 100644
index 000000000..71574763c
--- /dev/null
+++ b/scripts/qwen4exp_q51_lds_screen.py
@@ -0,0 +1,107 @@
+#!/usr/bin/env python3
+"""ED-1 main-kernel screen: real Q5_1 weights, synthetic activations/routing.
+
+No repair-chain or engine timing; never use this screen alone for promotion.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+import numpy as np
+
+from hipengine.core.hip import get_hip_runtime
+from hipengine.core.memory import free
+from hipengine.kernels.hip_gfx1100.quant import qwen4_exp_q5_1 as q51
+from hipengine.loading.gguf import GGUFReader, discover_gguf_files
+from scripts.qwen4exp_canonical_ar_bench import _git_metadata, _host_metadata
+from scripts.qwen4exp_moe_main_kernel_cost import _counts_for, _maps, _time_launch
+from tests.test_gpu_qwen4_exp_pf3_moe_schedules import (
+    _alloc, _upload, _download, _make_activation,
+)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--model-root', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--rows', type=int, default=10240)
+    parser.add_argument('--repetitions', type=int, default=15)
+    parser.add_argument('--distribution', choices=['balanced', 'uniform', 'sparse', 'single'],
+                        default='balanced')
+    args = parser.parse_args()
+    if args.rows < 512 or args.repetitions < 1:
+        parser.error('rows must be >=512 and repetitions positive')
+    runtime = get_hip_runtime()
+    library = q51.build_qwen4_exp_q5_1(load=True)
+    readers = [GGUFReader(p) for p in discover_gguf_files(args.model_root)]
+    name = 'blk.0.ffn_down_exps.weight'
+    reader = next(r for r in readers if any(t.name == name for t in r.info.tensors))
+    info = reader.tensor_info(name)
+    raw = reader.tensor_data(name)
+    assert raw.nbytes == 512 * 2560 * (640 // 32) * 24
+    counts = _counts_for(args.rows, 512, args.distribution, seed=20260928)
+    x, _ = _make_activation(args.rows, 640, seed=20260928)
+    report = dict(schema=1, kind='qwen4exp_q51_lds_main_screen',
+                  source=_git_metadata(ROOT), host=_host_metadata(), command=sys.argv,
+                  model_root=str(args.model_root), tensor=name, tensor_info=str(info),
+                  weight_sha256=hashlib.sha256(raw).hexdigest(), counts=counts,
+                  synthetic_activations=True, synthetic_routing=True,
+                  runtime_default_changed=False, cases=[])
+    allocations = []
+    try:
+        dx, dw = [_upload(a, runtime, allocations) for a in (x, raw)]
+        total = args.rows * 2560
+        out = _alloc(total, np.uint16, runtime, allocations)
+        rc = _alloc(1, np.int32, runtime, allocations)
+        ri = _alloc(total, np.int32, runtime, allocations)
+        baseline = None
+        for label, tile, suffix in [('j16', 16, ''), ('j32', 32, '_j32'),
+                                    ('j32_lds', 32, '_j32_lds'), ('j16_lds', 16, '_j16_lds'),
+                                    ('j16_repeat', 16, '')]:
+            compact, padded, owners, padded_rows = _maps(counts, tile)
+            ds, dp, dt = [_upload(np.asarray(a, dtype=np.int64), runtime, allocations)
+                          for a in (compact, padded, owners)]
+            fn = getattr(q51, f'qwen4_exp_q5_1_selected_wmma_iu8_risk{suffix}_prefill_bf16_bf16_out')
+            def launch(capacity=0):
+                fn(dx.ptr, ds.ptr, dp.ptr, dt.ptr, dw.ptr, out.ptr, rc.ptr, ri.ptr,
+                   capacity, 16.0, args.rows, 640, 2560, 512, padded_rows,
+                   library=library, runtime=runtime)
+            runtime.memset(rc.ptr, 0, 4)
+            launch(total)
+            output = _download(out, (total,), np.uint16, runtime)
+            n = int(_download(rc, (1,), np.int32, runtime)[0])
+            assert 0 <= n <= total
+            risks = np.sort(_download(ri, (total,), np.int32, runtime)[:n])
+            assert len(np.unique(risks)) == n
+            if baseline is None:
+                baseline = output, risks
+            np.testing.assert_array_equal(output, baseline[0])
+            np.testing.assert_array_equal(risks, baseline[1])
+            # Main-only: suppress risk-index writes for timing, like the earlier
+            # cost-attribution packet. Counter stays bounded across repeats.
+            if (args.repetitions + 2) * total >= 2**31:
+                raise ValueError('risk counter could overflow during timing')
+            runtime.memset(rc.ptr, 0, 4)
+            ms = _time_launch(launch, runtime, args.repetitions)
+            result = dict(variant=label, tile_rows=tile, padded_rows=padded_rows,
+                          main_median_ms=ms, parity=True, risk_count=n,
+                          timed_risk_capacity=0)
+            report['cases'].append(result)
+            print(json.dumps(result), flush=True)
+    finally:
+        runtime.device_synchronize()
+        for allocation in reversed(allocations):
+            free(allocation)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2) + '\n')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tests/test_gpu_qwen4exp_q51_iu8_lds.py b/tests/test_gpu_qwen4exp_q51_iu8_lds.py
new file mode 100644
index 000000000..e53f84727
--- /dev/null
+++ b/tests/test_gpu_qwen4exp_q51_iu8_lds.py
@@ -0,0 +1,60 @@
+"""ED-1 raw-weight LDS staging: parent outputs and unordered risk sets."""
+import numpy as np
+import pytest
+
+from hipengine.core.hip import get_hip_runtime
+from hipengine.core.memory import free
+from tests.test_gpu_qwen4exp_q51_iu8_exact import (
+    Fixture, hip_available, q51, _alloc, _upload, _download,
+)
+
+
+def run(fixture, runtime, library, allocations, *, tile_rows, staged):
+    counts = fixture.counts
+    starts = np.concatenate(([0], np.cumsum(counts))).astype(np.int64)
+    tiles = (counts + tile_rows - 1) // tile_rows
+    padded = np.concatenate(([0], np.cumsum(tiles) * tile_rows)).astype(np.int64)
+    owners = np.repeat(np.arange(len(counts), dtype=np.int64), tiles)
+    dx, ds, dp, dt, dw = [_upload(a, runtime, allocations) for a in
+                         (fixture.x_host, starts, padded, owners, fixture.qweight)]
+    total = fixture.compact_rows * fixture.out_features
+    out = _alloc(total, np.uint16, runtime, allocations)
+    rc = _upload(np.zeros(1, dtype=np.int32), runtime, allocations)
+    ri = _alloc(total, np.int32, runtime, allocations)
+    suffix = f'_j{tile_rows}_lds' if staged else ('' if tile_rows == 16 else '_j32')
+    fn = getattr(q51, f'qwen4_exp_q5_1_selected_wmma_iu8_risk{suffix}_prefill_bf16_bf16_out')
+    fn(
+        x_ptr=dx.ptr, expert_start_compact_ptr=ds.ptr,
+        expert_start_wmma_ptr=dp.ptr, tile_expert_ptr=dt.ptr, qweight_ptr=dw.ptr,
+        output_ptr=out.ptr, risk_count_ptr=rc.ptr, risk_indices_ptr=ri.ptr,
+        max_risks=total, risk_multiplier=16.0, compact_rows=fixture.compact_rows,
+        in_features=fixture.in_features, out_features=fixture.out_features,
+        num_experts=len(counts), wmma_total_rows=int(padded[-1]),
+        library=library, runtime=runtime)
+    n = int(_download(rc, (1,), np.int32, runtime)[0])
+    assert 0 <= n <= total
+    risks = _download(ri, (total,), np.int32, runtime)[:n]
+    assert len(np.unique(risks)) == n
+    assert np.all((risks >= 0) & (risks < total))
+    return _download(out, (total,), np.uint16, runtime), np.sort(risks)
+
+
+@pytest.mark.skipif(not hip_available(), reason='HIP runtime is not available')
+@pytest.mark.parametrize('k,n', [(32, 17), (288, 129), (640, 256)])
+def test_staged_weights_preserve_outputs_and_risk_membership(k, n):
+    fixture = Fixture(counts=[1, 0, 15, 16, 17, 31, 32, 33],
+                      in_features=k, out_features=n, seed=20260928)
+    runtime = get_hip_runtime()
+    library = q51.build_qwen4_exp_q5_1(load=True)
+    allocations = []
+    try:
+        baseline = run(fixture, runtime, library, allocations, tile_rows=16, staged=False)
+        for tile_rows, staged in [(32, False), (32, True), (32, True), (16, True)]:
+            result = run(fixture, runtime, library, allocations,
+                         tile_rows=tile_rows, staged=staged)
+            for actual, expected in zip(result, baseline):
+                np.testing.assert_array_equal(actual, expected)
+    finally:
+        runtime.device_synchronize()
+        for buffer in reversed(allocations):
+            free(buffer)
