  "change": {
    "summary": "Make the GGUF-MTP diagnostic default speed-first B1 linear greedy instead of the exact-verified K4096 branch tree.",
    "draft_n_max_default": 1,
    "root_topk_accept_default": {
      "old": 4096,
      "new": 1
    },
    "sibling_topk_accept_default": {
      "old": 4096,
      "new": 1
    },
    "topk_branch_redraft_default": {
      "old": true,
      "new": false
    },
    "rationale": "The K4096 branch tree raised accepted/output by enumerating millions of exact-verified candidates, but it made draft acceptance pathological and did not improve MTP tok/s. The linear B1 path maximizes measured diagnostic tok/s and accepted/generated-draft efficiency without prompt- or token-specific rescues."
  },
