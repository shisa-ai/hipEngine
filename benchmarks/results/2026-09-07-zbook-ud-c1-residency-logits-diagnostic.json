  "reproduction_sources": {
    "/tmp/ud-q56-suite.py": "import json, sys\nfrom pathlib import Path\nimport numpy as np\nfrom hipengine.loading.gguf import load_gguf_index\nfrom hipengine.tokenization.gguf import Qwen35GGUFTokenizer\nfrom hipengine.runtime.qwen35_gguf_runner import Qwen35GGUFResidentSession\nfrom scripts.gguf_mtp_bench import build_chat_prompt\nfrom scripts.gguf_mtp_category_bench import load_prompt_rows\nimport hipengine.loading.qwen35_gguf_materialize as materialize\n\nmode,kind=sys.argv[1:]\nassert mode in ('baseline','candidate') and kind in ('M','S')\nmodel=f'/models/gguf/Qwen3.8-27B-UD-Q4_K_{kind}.gguf'\nprefix=f'/tmp/ud-q56-suite-{kind}'\nif mode == 'candidate':\n    original=materialize._spec_for_tensor\n    def candidate(slot_path,tensor,**kwargs):\n        if len(tensor.shape)==2 and tensor.ggml_type_name in ('Q5_K','Q6_K'):\n            kwargs['decode_repack']=True\n        return original(slot_path,tensor,**kwargs)\n    materialize._spec_for_tensor=candidate\nrows=[]\nfor filename in ('mtpbench-code-general-ja.jsonl','gdn-prefill-category-heldouts.jsonl'):\n    rows.extend(load_prompt_rows(Path('benchmarks/prompts')/filename))\nassert len(rows)==18 and len({r['id'] for r in rows})==18\ntok=Qwen35GGUFTokenizer.from_gguf_info(load_gguf_index(model))\ninputs=[list(build_chat_prompt(tok,row['prompt'],reasoning='off')) for row in rows]\nteacher=None if mode=='baseline' else np.load(prefix+'-baseline.npz')\nlogits=[]; tokens=[]\nprint(mode,kind,'prompts',[(r['id'],len(p)) for r,p in zip(rows,inputs)],flush=True)\nwith Qwen35GGUFResidentSession(model,backend='hip_gfx1151',max_sequence_length=max(map(len,inputs))+16,compiler_version=Path('/tmp/ud-hipcc-version.txt').read_text()) as session:\n    allocations={a.buffer.ptr:a.buffer.nbytes for w in session.runner.weights.weights for a in w.allocations.values()}\n    allocated_weight_bytes=sum(allocations.values())\n    print('weight_buffer_bytes',allocated_weight_bytes,'allocation_mode',session.runner.weights.allocation_mode,flush=True)\n    for i,prompt in enumerate(inputs):\n        session.reset()\n        result=session.prefill(prompt,use_bulk=False,return_logits=True)\n        for j in range(9):\n            assert np.isfinite(result.logits).all()\n            logits.append(result.logits.copy())\n            chosen=int(result.token_id) if teacher is None else int(teacher['tokens'][9*i+j])\n            tokens.append(chosen)\n            if j<8:result=session.step(chosen,return_logits=True)\n        print(mode,kind,i,rows[i]['id'],flush=True)\nnp.savez(prefix+'-'+mode+'.npz',logits=np.asarray(logits),tokens=tokens)\nsummary={'model':model,'mode':mode,'allocated_weight_buffer_bytes':allocated_weight_bytes,'prompt_count':len(rows),'teacher_steps':9,'independent_teacher':False}\nif teacher is not None:\n    a=teacher['logits'].astype(np.float64); b=np.asarray(logits,dtype=np.float64)\n    a=a.reshape(-1,a.shape[-1]);b=b.reshape(a.shape)\n    def logsoft(x):\n        x=x-x.max(axis=-1,keepdims=True)\n        return x-np.log(np.exp(x).sum(axis=-1,keepdims=True))\n    la,lb=logsoft(a),logsoft(b)\n    kl=np.sum(np.exp(la)*(la-lb),axis=-1)\n    match=a.argmax(-1)==b.argmax(-1)\n    summary['kl_mean']=float(kl.mean());summary['kl_max']=float(kl.max());summary['top1']=float(match.mean())\n    summary['prompts']=[dict(id=r['id'],category=r['category'],kl=kl[9*i:9*(i+1)].tolist(),top1=match[9*i:9*(i+1)].tolist()) for i,r in enumerate(rows)]\nPath(prefix+'-'+mode+'.json').write_text(json.dumps(summary,indent=2)+'\\n')\nprint(json.dumps(summary),flush=True)\n",
    "/tmp/ud-llama-teacher-input.py": "import struct\nfrom pathlib import Path\nimport numpy as np\nfrom hipengine.loading.gguf import load_gguf_index\nfrom hipengine.tokenization.gguf import Qwen35GGUFTokenizer\nfrom scripts.gguf_mtp_bench import build_chat_prompt\nfrom scripts.gguf_mtp_category_bench import load_prompt_rows\nrows=[]\nfor filename in ('mtpbench-code-general-ja.jsonl','gdn-prefill-category-heldouts.jsonl'):\n    rows.extend(load_prompt_rows(Path('benchmarks/prompts')/filename))\nassert len(rows)==18\nfor kind in ('M','S'):\n    tok=Qwen35GGUFTokenizer.from_gguf_info(load_gguf_index(f'/models/gguf/Qwen3.8-27B-UD-Q4_K_{kind}.gguf'))\n    prompts=[list(build_chat_prompt(tok,r['prompt'],reasoning='off')) for r in rows]\n    with np.load(f'/tmp/ud-q56-suite-{kind}-baseline.npz') as teacher:\n        tokens=teacher['tokens'].reshape(18,9)\n    with Path(f'/tmp/ud-llama-teacher-{kind}.bin').open('wb') as out:\n        out.write(b'Q36Q'+struct.pack('<II',1,18))\n        for prompt,forced in zip(prompts,tokens):\n            out.write(struct.pack('<II',len(prompt),len(forced)))\n            out.write(np.asarray(prompt,dtype='<i4').tobytes())\n            out.write(np.asarray(forced,dtype='<i4').tobytes())\n    print(kind,'18 prompts, 162 rows')\n"
