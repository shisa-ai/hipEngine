se '特に') if chat else 'Rayleigh'\n                if logs:req.update({'logprobs':True,'top_logprobs':3} if chat else {'logprobs':3})\n                endpoint='/v1/chat/completions' if chat else '/v1/completions'\n                pair=[]\n                for stream in (False,True):\n                    body=req|{'stream':stream}\n                    if stream:body['stream_options']={'include_usage':True,'include_hipengine':True}\n                    row={'chat':chat,'logs':logs,'lang':lang,'request':body};r['rows'].append(row)\n                    start=time.monotonic()\n                    try:\n                        if stream:\n                            events=[];times=[];done=False\n                            with c.stream('POST',endpoint,json=body) as response:\n                                row['status']=response.status_code;response.raise_for_status()\n                                for line in response.iter_lines():\n                                    if not line.startswith('data: '):continue\n                                    data=line[6:]\n                                    if data=='[DONE]':done=True;continue\n                                    event=json.loads(data);events.append(event)\n                                    for choice in event.get('choices',[]):\n                                        piece=(choice.get('delta') or {}).get('content','') if chat else choice.get('text','')\n                                        if piece:times.append(time.monotonic()-start)\n                            row.update(body=events,content_event_times=times,done=done)\n                            assert done\n                        else:\n                            response=c.post(endpoint,json=body);row['status']=response.status_code;row['body']=response.json();response.raise_for_status()\n                        row['wall_seconds']=time.monotonic()-start\n                        result=extract(row['body'],chat=chat);row['result']=result\n         