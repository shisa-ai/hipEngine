    "exception": "RuntimeError: GGUF MTP2 prompt activation claims are already reserved",
    "source": "worklog/entries/20260917T162126.651176Z-lhl-sharegpt-mtp-routing-pass-8d7978.md",
    "summary": "At concurrency >= 4 the engine service dies and every later request fails with HTTP 500. The crash is a single-slot prompt-activation guard in the MTP adapter: an incremental (multi-chunk) prefill opens prompt activation claims that stay open across ticks until the final chunk, so any other request's prompt activation raises.",
    "traceback_chain": [
      "engine_service._drive: events = tuple(self._driver.poll(max_ticks=1))",
      "engine_loop.poll -> tick -> _tick_once -> _run_prefill",
      "qwen35_gguf.prefill_batch: self._prefill_native_chunk(row, model_chunk, final_chunk=final_chunk)",
      "qwen35_gguf._prefill_native_chunk (line 8876): streaming_sinks = self._begin_mtp2_prompt_streaming((row,))",
      "qwen35_gguf._begin_mtp2_prompt_streaming (line 8366): adapter.begin_prompt_streaming(...)",
      "qwen35_gguf_mtp2.begin_prompt_streaming (line 1372): raise RuntimeError('GGUF MTP2 prompt activation claims are already reserved')"
    ]
