  "mechanism": {
    "long_prefill": "global layers remain chunk-batched; each sliding layer restores pre-chunk KVLiveSpans, batches the safe pre-wrap segment, and appends/attends post-wrap rows serially so no query observes an overwritten ring slot",
    "public_admission": "one resident c1 runner owns immutable packed weights while a fixed-capacity MapleBatchRunner owns request-local SWA/global KV rings; prompt chunks prefill directly into their physical slot and c2/c4/c8 use the retained D1 batched path",
    "single_active": "when exactly one request advances, its request-local K/V view runs the retained D0 c1 step rather than evaluating inactive dense rows",
    "slot_policy": "first-free fixed physical slots with sparse masks; release/reset on rollback, cancellation, completion, and reclaim"
  },
