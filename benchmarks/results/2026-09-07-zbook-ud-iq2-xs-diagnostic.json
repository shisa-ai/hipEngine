  "reproduction_source": "\"\"\"Diagnostic only: raw IQ2_XS versus baseline UD K_S, same forced tokens.\"\"\"\nimport json\nimport sys\nfrom pathlib import Path\nimport numpy as np\nimport hipengine.loading.qwen35_gguf_consumer_surface as surface\nimport hipengine.loading.qwen35_gguf_admission as admission\nsurface.RAW_LINEAR_SOURCE_QUANT_KEYS = dict(surface.RAW_LINEAR_SOURCE_QUANT_KEYS, IQ2_XS='gguf_iq2_xs')\nadmission.RAW_LINEAR_SOURCE_QUANT_KEYS = surface.RAW_LINEAR_SOURCE_QUANT_KEYS\nsurface._RAW_LINEAR_OUTPUTS = dict(surface._RAW_LINEAR_OUTPUTS, IQ2_XS=frozenset({'bf16','f32'}))\nadmission.CERTIFIED_OPERATION_COVERAGE = admission._certified_coverage()\nadmission._COVERAGE_INDEX = admission._build_coverage_index(admission.CERTIFIED_OPERATION_COVERAGE)\nfrom hipengine.loading.gguf import load_gguf_index\nfrom hipengine.tokenization.gguf import Qwen35GGUFTokenizer\nfrom hipengine.runtime.qwen35_gguf_runner import Qwen35GGUFResidentSession\nfrom scripts.gguf_mtp_bench import build_chat_prompt\nfrom scripts.gguf_mtp_category_bench import load_prompt_rows\nimport hipengine.loading.qwen35_gguf_materialize as materialize\n\nmodel='/models/gguf/Qwen3.8-27B-UD-Q4_K_S.gguf'\nassert len(sys.argv) == 1 or (len(sys.argv) == 2 and sys.argv[1] in ('repeat2', 'repeat3'))\nprefix='/tmp/ud-iq2-xs-suite-S' + ('-'+sys.argv[1] if len(sys.argv)>1 else '')\nteacher=np.load('/tmp/ud-q56-suite-S-baseline.npz')\noriginal=materialize._spec_for_tensor\ndef candidate(slot_path,tensor,**kwargs):\n    if len(tensor.shape)==2 and slot_path.startswith('layers.') and tensor.ggml_type_name=='IQ2_XS':\n        return materialize.Qwen35GGUFWeightSpec(slot_path=slot_path, source=tensor,\n            quant_key='gguf_iq2_xs', layout=materialize.LAYOUT_RAW_GGUF, allocation_names=('raw',))\n    return original(slot_path,tensor,**kwargs)\nmaterialize._spec_for_tensor=candidate\nrows=[]\nfor filename in ('mtpbench-code-general-ja.jsonl','gdn-prefill-category-heldouts.jsonl'):\n    rows.extend(load_prompt_rows(Path('benchmarks/prompts')/filename))\nassert len(rows)==18 and len({r['id'] for r in rows})==18\ntok=Qwen35GGUFTokenizer.from_gguf_info(load_gguf_index(model))\ninputs=[list(build_chat_prompt(tok,row['prompt'],reasoning='off')) for row in rows]\nlogits=[]\nprint('raw IQ2_XS S prompts',[(r['id'],len(p)) for r,p in zip(rows,inputs)],flush=True)\nwith Qwen35GGUFResidentSession(model,backend='hip_gfx1151',max_sequence_length=max(map(len,inputs))+16,compiler_version=Path('/tmp/ud-hipcc-version.txt').read_text()) as session:\n    allocations={a.buffer.ptr:a.buffer.nbytes for w in session.runner.weights.weights for a in w.allocations.values()}\n    allocated_weight_bytes=sum(allocations.values())\n    print('weight_buffer_bytes',allocated_weight_bytes,'allocation_mode',session.runner.weights.allocation_mode,flush=True)\n    for i,prompt in enumerate(inputs):\n        session.reset()\n        result=session.prefill(prompt,use_bulk=False,return_logits=True)\n        for j in range(9):\n            assert np.isfinite(result.logits).all()\n            logits.append(result.logits.copy())\n            if j<8:result=session.step(int(teacher['tokens'][9*i+j]),return_logits=True)\n        print('raw IQ2_XS S',i,rows[i]['id'],flush=True)\nnp.savez(prefix+'.npz',logits=np.asarray(logits),tokens=teacher['tokens'])\na=teacher['logits'].astype(np.float64); b=np.asarray(logits,dtype=np.float64)\na=a.reshape(-1,a.shape[-1]);b=b.reshape(a.shape)\ndef logsoft(x):\n    x=x-x.max(axis=-1,keepdims=True)\n    return x-np.log(np.exp(x).sum(axis=-1,keepdims=True))\nla,lb=logsoft(a),logsoft(b)\nkl=np.sum(np.exp(la)*(la-lb),axis=-1)\nmatch=a.argmax(-1)==b.argmax(-1)\nsummary={'model':model,'mode':'raw_iq2_xs','allocated_weight_buffer_bytes':allocated_weight_bytes,'prompt_count':len(rows),'teacher_steps':9,'independent_teacher':False,'kl_mean':float(kl.mean()),'kl_max':float(kl.max()),'top1':float(match.mean()),'prompts':[dict(id=r['id'],category=r['category'],kl=kl[9*i:9*(i+1)].tolist(),top1=match[9*i:9*(i+1)].tolist()) for i,r in enumerate(rows)]}\nPath(prefix+'.json').write_text(json.dumps(summary,indent=2)+'\\n')\nprint(json.dumps(summary),flush=True)\n",
