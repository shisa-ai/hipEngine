  "probe_source": "import sys, json, time, subprocess, socket\nfrom pathlib import Path\nsys.path.insert(0, '/home/lhl/hipEngine')\nimport httpx\nfrom scripts.qwen4exp_controlled_mtp_http_gate import cases, structured, validate_control, validate_hard_thinking\nfrom scripts.qwen4exp_sampled_mtp_http_gate import extract\nreport = dict(source_commit=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(), host=socket.gethostname(), rows=[])\np = Path('/tmp/he-live-structured-timing.json')\ndef save(): p.write_text(json.dumps(report, ensure_ascii=False, indent=2)+'\\n')\nwith httpx.Client(base_url='http://127.0.0.1:18389', timeout=240) as c:\n    deadline=time.monotonic()+600\n    while True:\n        try:\n            r=c.get('/ready',timeout=5)\n            if r.status_code==200 and r.json().get('ready'): break\n        except httpx.TransportError: pass\n        if time.monotonic()>deadline: raise TimeoutError('readiness')\n        time.sleep(1)\n    report['ready_before']=r.json()\n    r=c.post('/v1/hipengine/tokenize',json={'text':'</think>'});r.raise_for_status()\n    close_ids=r.json()['token_ids']\n    for case in cases('qwen38fn-sampling'):\n        req=case['request']\n        if req['temperature']!=0 or not req['stream'] or not req.get('speculative'): continue\n        row=case | {'events':[], 'arrivals':[]}; report['rows'].append(row)\n        start=time.monotonic(); done=False\n        try:\n            with c.stream('POST','/v1/chat/completions',json=req) as response:\n                row['status']=response.status_code;response.raise_for_status()\n                for line in response.iter_lines():\n                    if not line.startswith('data: '):continue\n                    data=line[6:]\n                    if data=='[DONE]':done=True;continue\n                    event=json.loads(data);row['events'].append(event)\n                    for choice in event.get('choices',[]):\n                        delta=choice.get('delta') or {}\n                        for field in ('content','reasoning_content','tool_calls'):\n                            if delta.get(field):row['arrivals'].append({'field':field,'seconds':time.monotonic()-start})\n            row['wall_seconds']=time.monotonic()-start\n            assert done\n            result=extract(row['events'],chat=True) | structured(row['events'])\n            row['result']=result\n            validate_control(result,kind=case['kind'],logs=bool(req.get('logprobs')))\n            if case['kind']=='hard_thinking':validate_hard_thinking(result,cap=req['hard_think_cap'],close_ids=close_ids)\n            row['correct']=True\n            row['early_delivery']=bool(row['arrivals'] and row['arrivals'][0]['seconds'] < row['wall_seconds']-.1)\n        except Exception as error:row.update(correct=False,error=repr(error))\n        save();print(row['name'], row.get('correct'), row.get('early_delivery'), row.get('error',''),flush=True)\n    report['ready_after']=c.get('/ready').json();save()\n",
