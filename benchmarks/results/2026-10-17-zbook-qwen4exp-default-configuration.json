  "probe_source": "import sys, time, json, subprocess, socket\nfrom pathlib import Path\nsys.path.insert(0, '/home/lhl/hipEngine')\nimport httpx\nfrom hipengine import LLM\nfrom scripts.qwen4exp_sampled_mtp_http_gate import extract\nfrom scripts.qwen4exp_controlled_mtp_http_gate import SCHEMA, EXPECTED\nout=Path('/tmp/he-task29-live-defaults.json')\nr={'source_commit': subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(), 'host':socket.gethostname(), 'requests':[], 'passed':False}\ndef save(): out.write_text(json.dumps(r,indent=2)+'\\n')\ntry:\n    explicit=LLM('/models/gguf/unsloth-Qwen3.8-Flash-Next-UD-Q4_K_XL/UD-Q4_K_XL',backend='hip_gfx1151',quant='gguf_ud_q4_k_xl')\n    explicit._load_model_metadata()\n    from hipengine.generation.qwen4_exp_profiles import register_qwen4_exp_gfx1151_profiles\n    register_qwen4_exp_gfx1151_profiles()\n    r['explicit_manifest_sha256']=explicit.execution_profile_manifest_sha256\n    assert r['explicit_manifest_sha256'] is not None\n    with httpx.Client(base_url='http://127.0.0.1:18389', timeout=600) as c:\n        deadline=time.monotonic()+900\n        while True:\n            try:\n                ready=c.get('/ready',timeout=5)\n                if ready.status_code==200 and ready.json().get('ready'): break\n            except httpx.TransportError: pass\n            if time.monotonic()>deadline: raise TimeoutError('server readiness')\n            time.sleep(2)\n        models=c.get('/v1/models');models.raise_for_status()\n        r['models']=models.json();save()\n        info=r['models']['data'][0]['hipengine'];profile=info['execution_profile']\n        assert info['quant']=='gguf_ud_q4_k_xl',info\n        assert profile['resolved']=='production',profile\n        assert profile['manifest_sha256']==r['explicit_manifest_sha256'],profile\n        assert not profile['fell_back_to_strict'],profile\n        for mtp in (False,True):\n            req={'model':'qwen38fn-sampling','max_tokens':64,'seed':104,'enable_thinking':False,'messages':[{'role':'user','content':'Return the requested JSON object.'}],'response_format':SCHEMA,'temperature':0.0,'stream':False,'speculative':mtp}\n            response=c.post('/v1/chat/completions',json=req)\n            row={'request':req,'status':response.status_code,'body':response.json()};r['requests'].append(row);save()\n            response.raise_for_status()\n            result=extract(row['body'],chat=True);row['result']=result;save()\n            assert json.loads(result['text'])==EXPECTED,result\n            assert result['mtp']['used'] is mtp,result\n            print('MTP' if mtp else 'AR','PASS',flush=True)\n        r['ready_after']=c.get('/ready').json()\n        assert r['ready_after'].get('ready') is True\n        r['passed']=True;save();print('DEFAULT_CONFIG_PASS',flush=True)\nexcept Exception as e:\n    r['error']=repr(e);save();raise\n",
