  "probe_command": "uv run python /tmp/he-task20-live-native.py",
  "probe_source": "import sys, json, time, socket, subprocess\nfrom pathlib import Path\nsys.path.insert(0, '/home/lhl/hipEngine')\nimport httpx\nfrom scripts.qwen4exp_sampled_mtp_http_gate import extract, validate_route, fingerprint\nr={'source_commit':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),'host':socket.gethostname(),'rows':[],'errors':[]}\np=Path('/tmp/he-task20-live-native.json')\ndef save(): p.write_text(json.dumps(r,ensure_ascii=False,indent=2)+'\\n')\nwith httpx.Client(base_url='http://127.0.0.1:18389',timeout=180) as c:\n    end=time.monotonic()+600\n    while True:\n        try:\n            ready=c.get('/ready',timeout=5)\n            if ready.status_code==200 and ready.json().get('ready'):break\n        except httpx.TransportError:pass\n        if time.monotonic()>end:raise TimeoutError('readiness')\n        time.sleep(1)\n    r['ready_before']=ready.json();r['models']=c.get('/v1/models').json();save()\n    for chat in (False,True):\n        for logs in (False,True):\n            for lang in ('en','ja'):\n                prompt='Explain why the sky is blue in several sentences.' if lang=='en' else '日本語で、空が青い理由を数文で説明してください。'\n                req={'model':'qwen38fn-sampling','max_tokens':48,'temperature':0.0,'seed':104,'speculative':True,'enable_thinking':False}\n                req.update({'messages':[{'role':'user','content':prompt}]} if chat else {'prompt':prompt})\n                if not chat:req.pop('enable_thinking')\n                if logs:req.update({'logprobs':True,'top_logprobs':3} if chat else {'logprobs':3})\n                endpoint='/v1/chat/completions' if chat else '/v1/completions'\n                pair=[]\n                for stream in (False,True):\n                    body=req|{'stream':stream}\n                    if stream:body['stream_options']={'include_usage':True,'include_hipengine':True}\n                    row={'chat':chat,'logs':logs,'lang':lang,'request':body};r['rows'].append(row)\n                    start=time.monotonic()\n                    try:\n                        if stream:\n                            events=[];times=[];done=False\n                            with c.stream('POST',endpoint,json=body) as response:\n                                row['status']=response.status_code;response.raise_for_status()\n                                for line in response.iter_lines():\n                                    if not line.startswith('data: '):continue\n                                    data=line[6:]\n                                    if data=='[DONE]':done=True;continue\n                                    event=json.loads(data);events.append(event)\n                                    for choice in event.get('choices',[]):\n                                        piece=(choice.get('delta') or {}).get('content','') if chat else choice.get('text','')\n                                        if piece:times.append(time.monotonic()-start)\n                            row.update(body=events,content_event_times=times,done=done)\n                            assert done\n                        else:\n                            response=c.post(endpoint,json=body);row['status']=response.status_code;row['body']=response.json();response.raise_for_status()\n                        row['wall_seconds']=time.monotonic()-start\n                        result=extract(row['body'],chat=chat);row['result']=result\n                        if logs:\n                            validate_route(result,mtp=True,logs=True,full_mass=False)\n                        else:\n                            assert result['mtp']['used'] and result['mtp']['draft_cycles']>0\n                            assert result['usage']['completion_tokens']==len(result['ids'])\n                        if stream:assert len(times)>1 and times[0]<row['wall_seconds']-.1, 'not incremental'\n                        pair.append(result);row['passed']=True\n                    except Exception as e:row['error']=repr(e);r['errors'].append({'chat':chat,'logs':logs,'lang':lang,'stream':stream,'error':repr(e)})\n                    save();print(chat,logs,lang,stream,row.get('error','PASS'),flush=True)\n                if len(pair)==2:\n                    def comparable(x):\n                        d=fingerprint(x)\n                        d['finish']={k:v for k,v in d['finish'].items() if k not in ('continuation_id','continuation_eligible')}\n                        return d\n                    if comparable(pair[0])!=comparable(pair[1]):r['errors'].append({'chat':chat,'logs':logs,'lang':lang,'error':'blocking/SSE mismatch'})\n                    save()\n    # Close a running response after the first visible token, then prove recovery.\n    req={'model':'qwen38fn-sampling','prompt':'Write a long explanation of how a computer works.','max_tokens':512,'temperature':0.0,'speculative':True,'stream':True}\n    with c.stream('POST','/v1/completions',json=req) as response:\n        response.raise_for_status()\n        for line in response.iter_lines():\n            if line.startswith('data: {'):\n                event=json.loads(line[6:])\n                if any(x.get('text') for x in event.get('choices',[])):break\n    response=c.post('/v1/completions',json=req|{'stream':False,'max_tokens':32})\n    r['recovery']={'status':response.status_code,'body':response.json()}\n    if response.status_code!=200:r['errors'].append({'error':'disconnect recovery failed'})\n    r['ready_after']=c.get('/ready').json();r['passed']=not r['errors'];save()\nprint('LIVE_NATIVE_COMPLETE',r['passed'],flush=True)\n",
