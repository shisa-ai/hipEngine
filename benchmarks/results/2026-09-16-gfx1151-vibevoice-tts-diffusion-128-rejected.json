    "probe_source": "import json,hashlib\nfrom pathlib import Path\nimport numpy as np\nimport torch\nfrom transformers import WhisperForConditionalGeneration,WhisperProcessor\nfrom transformers.models.whisper.english_normalizer import EnglishTextNormalizer\nfrom jiwer import wer\n\ntorch.set_num_threads(8)\nmodelid='openai/whisper-large-v3-turbo'\np=WhisperProcessor.from_pretrained(modelid,local_files_only=True)\nm=WhisperForConditionalGeneration.from_pretrained(modelid,torch_dtype=torch.float32,local_files_only=True).eval()\nnorm=EnglishTextNormalizer({})\nnew={'runs':[{'requests':json.load(open('/tmp/vv-drift-quality128-rest/synthesis.json'))}]}\nold=json.load(open('benchmarks/results/2026-09-15-gfx1151-vibevoice-tts-quality-suite.json'))\nres=[]\nfor label,data in [('old_archive',old),('repair',new)]:\n for run in data['runs']:\n  for r in run['requests']:\n   if (r['base_seed'],r['name']) not in [(20260917,'single-numbers')]:continue\n   path=Path(r['pcm']);a=np.load(path).astype(np.float32)\n   x=torch.from_numpy(a).reshape(1,1,-1)\n   x=torch.nn.functional.interpolate(x,size=int(a.size*16000/24000),mode='linear',align_corners=False)[0,0]\n   feats=p(x.numpy(),sampling_rate=16000,return_tensors='pt').input_features\n   with torch.inference_mode(): ids=m.generate(feats,language='en',task='transcribe',num_beams=5)\n   text=p.batch_decode(ids,skip_special_tokens=True)[0].strip()\n   ref=' '.join(line.split(':',1)[-1] for line in r['script'].splitlines())\n   row={'arm':label,'seed':r['base_seed'],'request':r['name'],'pcm_npy_sha256':hashlib.sha256(path.read_bytes()).hexdigest(),'transcript':text,'wer_fraction':wer(norm(ref),norm(text))}\n   res.append(row);print(json.dumps(row),flush=True)\nPath('/tmp/vv-drift128-whisper.json').write_text(json.dumps({'model':modelid,'dtype':'float32','device':'cpu','num_beams':5,'resampling':'torch interpolate linear 24k to 16k align_corners=False','normalization':'Whisper EnglishTextNormalizer','results':res},indent=2)+'\\n')\n"
