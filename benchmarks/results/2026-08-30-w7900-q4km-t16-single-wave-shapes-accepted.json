  "down_projection_is_the_remaining_gap": {
    "shape": "(17408, 5120), the FFN down projection",
    "owner_ms_at_suite_rows": {
      "35": 1.231,
      "48": 1.25,
      "67": 1.374
    },
    "reading": "it is the most expensive dense launch in the prefill wall and 1.7x slower than gate/up on the same 51.5 MB of weights, because out_features=5120 gives the shared-B grid only ~107 column blocks against 512 compute units, so the launch cannot saturate memory. No registered leaf beats it: single-wave is 0.77x-0.83x and the rows6 rowtile is neutral outside row 6. Closing it needs a split-K or column-resplit kernel, which is new kernel work with its own RED gate, not a declaration.",
    "other_measured_losses": "(5120,6144), (6144,5120) and (5120,1024) have no registered leaf that beats shared-B at these rows either; their owners cost 0.30-0.49 ms."
  },
  "gates": {
    "red_first": "tests/test_gguf_q4_k_t16_dense.py failed on the three-shape policy set before the shapes were added",
    "unit": "pytest tests/test_gguf_q4_k_t16_dense.py tests/test_gguf_q4_k_wmma_prefill.py -> 151 passed",
    "numerics": "bit-exact at every measured row and shape, so no KL/top-1 gate was required for the changed leaves",
    "fallback": "shared-B remains the registered strict sibling; HIPENGINE_GGUF_Q4_T16_SINGLE_WAVE_MAX_ROWS=0 disables the whole band on the same build"
  },
