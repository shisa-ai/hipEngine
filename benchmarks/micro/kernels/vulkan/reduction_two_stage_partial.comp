#version 450

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer XBuffer {
    float x[];
};

layout(set = 0, binding = 1) readonly buffer WBuffer {
    float w[];
};

layout(set = 0, binding = 2) buffer PartialBuffer {
    float partials[];
};

layout(set = 0, binding = 3) buffer OutBuffer {
    float out_values[];
};

layout(push_constant) uniform PushConstants {
    uint k;
    uint rows;
    uint body_repeats;
    uint split_count;
    uint output_slice;
    uint sequence_id;
} pc;

shared float scratch[256];

void main() {
    uint row = gl_WorkGroupID.x;
    uint split = gl_WorkGroupID.y;
    uint lid = gl_LocalInvocationID.x;
    uint wg = gl_WorkGroupSize.x;
    uint start = (pc.k * split) / pc.split_count;
    uint end = (pc.k * (split + 1u)) / pc.split_count;
    float sum = 0.0;

    for (uint repeat = 0u; repeat < pc.body_repeats; ++repeat) {
        for (uint i = start + lid; i < end; i += wg) {
            uint j = (i + repeat) % pc.k;
            sum = fma(x[j], w[row * pc.k + j], sum);
        }
    }

    scratch[lid] = sum;
    barrier();

    for (uint offset = wg >> 1u; offset > 0u; offset >>= 1u) {
        if (lid < offset) {
            scratch[lid] += scratch[lid + offset];
        }
        barrier();
    }

    if (lid == 0u) {
        uint slice_stride = pc.rows * pc.split_count;
        partials[pc.output_slice * slice_stride + row * pc.split_count + split] = scratch[0];
    }
}
