#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer XBuffer {
    float x[];
};

layout(set = 0, binding = 1) readonly buffer WBuffer {
    float w[];
};

layout(set = 0, binding = 2) buffer OutBuffer {
    float out_values[];
};

layout(push_constant) uniform PushConstants {
    uint k;
    uint rows;
    uint body_repeats;
    uint reserved;
} pc;

shared float subgroup_sums[8];

void main() {
    uint row = gl_WorkGroupID.x;
    uint lid = gl_LocalInvocationID.x;
    uint wg = gl_WorkGroupSize.x;
    float sum = 0.0;

    for (uint repeat = 0; repeat < pc.body_repeats; ++repeat) {
        for (uint i = lid; i < pc.k; i += wg) {
            uint j = (i + repeat) % pc.k;
            sum = fma(x[j], w[row * pc.k + j], sum);
        }
    }

    float subgroup_sum = subgroupAdd(sum);
    if (gl_SubgroupInvocationID == 0) {
        subgroup_sums[gl_SubgroupID] = subgroup_sum;
    }
    barrier();

    if (gl_SubgroupID == 0) {
        float partial = gl_SubgroupInvocationID < gl_NumSubgroups
            ? subgroup_sums[gl_SubgroupInvocationID]
            : 0.0;
        float total = subgroupAdd(partial);
        if (gl_SubgroupInvocationID == 0) {
            out_values[row] = total;
        }
    }
}
