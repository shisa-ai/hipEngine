  "description": "Project-original hermetic repository, code, instruction, no-tool, multiple-call, and fail-safe oracle data. Hidden expected behavior is never rendered into model prompts.",
  "fail_safe_controls": [
    {
      "class": "malformed",
      "expected": {
        "accepted": false,
        "finish_reason": "invalid_tool_call",
        "public_content_empty": true,
        "public_tool_call_count": 0,
        "session_commit": "none"
      },
      "id": "aq2_dev_control_malformed_json",
      "raw_text": "<tool_call>{\"name\":\"read_file\",\"arguments\":}</tool_call>",
      "split": "development",
      "tools_mode": "auto"
