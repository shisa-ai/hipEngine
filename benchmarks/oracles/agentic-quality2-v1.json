  "files": {
    "config/stations.json": "{\"stations\":[\"north-2\",\"west-17\"],\"sample_cap\":64,\"retry_ms\":250}\n",
    "docs/operator.md": "Operator guide\n- Inspect stale samples before restart.\n- Keep one rollback snapshot.\n- Escalate after three failed retries.\n",
    "docs/operator_ja.md": "運用ガイド\n- 監視アラートを確認する。\n- 復旧前にロールバックスナップショットを保持する。\n- 3回失敗したら担当者へ通知する。\n",
    "src/ingest.py": "class SampleOverflow(RuntimeError):\n    pass\n\n\ndef accept_batch(count: int, cap: int) -> str:\n    if count > cap:\n        raise ValueError(\"too many samples\")\n    return \"accepted\"\n",
    "src/retry.py": "def retry_delay(attempt: int, base_ms: int = 250) -> int:\n    return base_ms * attempt\n"
  },
