{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hipEngine execution-profile capture manifest",
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "scenario_step",
        "request_id",
        "teacher_step",
        "teacher_token_id",
        "category",
        "shape",
        "transition"
      ],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "scenario_step": {"type": "integer", "minimum": 0},
        "request_id": {"type": "string", "minLength": 1},
        "teacher_step": {"type": "integer", "minimum": 0},
        "teacher_token_id": {"type": "integer", "minimum": 0},
        "category": {"type": "string", "minLength": 1},
        "shape": {"type": "string", "minLength": 1},
        "transition": {"type": "string", "minLength": 1}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "scenario_step",
        "work_class",
        "request_id",
        "physical_slot",
        "execution_row",
        "physical_width",
        "input_token_id",
        "position",
        "context_length",
        "active",
        "active_mask_hash",
        "mask_manifest_hash",
        "publication_ordinal",
        "transaction_id",
        "transaction_phase",
        "accepted_token_count",
        "route_decision_hash",
        "route_scatter_owner_hash",
        "route_owner_request_id",
        "route_top_k",
        "kv_base_offset",
        "kv_live_count",
        "kv_token_position",
        "kv_evict",
        "kv_values_finite",
        "kv_append_ordinal",
        "state_owner_request_id",
        "state_update_ordinal",
        "state_values_finite",
        "rng_owner_request_id",
        "rng_seed",
        "rng_counter",
        "route_values_finite",
        "graph_bucket"
      ],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "scenario_step": {"type": "integer", "minimum": 0},
        "work_class": {"type": "string", "minLength": 1},
        "request_id": {"type": "string", "minLength": 1},
        "physical_slot": {"type": "integer", "minimum": 0},
        "execution_row": {"type": "integer", "minimum": 0},
        "physical_width": {"type": "integer", "minimum": 1},
        "input_token_id": {"type": "integer", "minimum": 0},
        "position": {"type": "integer", "minimum": 0},
        "context_length": {"type": "integer", "minimum": 0},
        "active": {"type": "boolean"},
        "active_mask_hash": {"type": "string", "minLength": 1},
        "mask_manifest_hash": {"type": "string", "minLength": 1},
        "publication_ordinal": {"type": "integer", "minimum": 0},
        "transaction_id": {"type": "string", "minLength": 1},
        "transaction_phase": {"type": "string", "minLength": 1},
        "accepted_token_count": {"type": "integer", "minimum": 0},
        "route_decision_hash": {"type": "string", "minLength": 1},
        "route_scatter_owner_hash": {"type": "string", "minLength": 1},
        "route_owner_request_id": {"type": "string", "minLength": 1},
        "route_top_k": {"type": "integer", "minimum": 0},
        "kv_base_offset": {"type": "integer", "minimum": 0},
        "kv_live_count": {"type": "integer", "minimum": 0},
        "kv_token_position": {"type": "integer", "minimum": 0},
        "kv_evict": {"type": "boolean"},
        "kv_values_finite": {"type": "boolean"},
        "kv_append_ordinal": {"type": "integer", "minimum": 0},
        "state_owner_request_id": {"type": "string", "minLength": 1},
        "state_update_ordinal": {"type": "integer", "minimum": 0},
        "state_values_finite": {"type": "boolean"},
        "rng_owner_request_id": {"type": "string", "minLength": 1},
        "rng_seed": {"type": "integer", "minimum": 0},
        "rng_counter": {"type": "integer", "minimum": 0},
        "route_values_finite": {"type": "boolean"},
        "graph_bucket": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "execution_profile",
    "scenario_id",
    "run_id",
    "variant_manifest_sha256",
    "repeat_index",
    "logits_path",
    "rows",
    "selected_token_ids",
    "controls"
  ],
  "properties": {
    "kind": {"const": "hipengine_execution_profile_capture"},
    "schema_version": {"const": 1},
    "execution_profile": {
      "enum": ["strict", "production", "batch_invariant"]
    },
    "scenario_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "variant_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repeat_index": {"type": "integer", "minimum": 0},
    "logits_path": {"type": "string", "minLength": 1},
    "logits_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}},
    "selected_token_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 0}
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/control"}
    }
  }
}
