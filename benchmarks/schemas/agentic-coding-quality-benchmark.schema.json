{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hipengine.dev/schemas/agentic-coding-quality-benchmark.schema.json",
  "title": "hipEngine natural coding-agent tool-quality artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schema_version", "created_at", "performance_claim", "workload_suite",
    "configuration", "coverage", "validation", "quality", "final_ownership",
    "turn_records_sha256", "turn_records"
  ],
  "properties": {
    "kind": {"const": "hipengine_agentic_coding_quality_benchmark"},
    "schema_version": {"const": 1},
    "created_at": {"type": "string", "minLength": 1},
    "performance_claim": {"const": false},
    "hipengine_artifact_provenance": {
      "$ref": "artifact-provenance.schema.json"
    },
    "workload_suite": {
      "type": "object",
      "required": [
        "path", "kind", "schema_version", "suite", "file_sha256",
        "canonical_sha256", "workload_sha256"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"const": "hipengine.agentic_coding_workloads"},
        "schema_version": {"const": 1},
        "suite": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "workload_sha256": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "quality_oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "file_sha256", "kind", "schema_version", "suite"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "kind": {"const": "hipengine.agentic_quality_oracles"},
            "schema_version": {"const": 1},
            "suite": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "configuration": {
      "$ref": "agentic-coding-quality-records.schema.json#/$defs/configuration"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workloads", "runs", "concurrency", "agents", "turns", "generated_tokens"],
      "properties": {
        "workloads": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "runs": {"type": "integer", "minimum": 1},
        "concurrency": {"type": "integer", "minimum": 1},
        "agents": {"type": "integer", "minimum": 1},
        "turns": {"type": "integer", "minimum": 1},
        "generated_tokens": {"type": "integer", "minimum": 1},
        "families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["repository", "general_en", "general_ja", "mixed_ja_en"]}
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failure_reasons"],
      "properties": {
        "passed": {"const": true},
        "failure_reasons": {"type": "array", "maxItems": 0}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts", "valid_calls", "correct_tools", "exact_arguments", "successes",
        "valid_call_rate", "correct_tool_rate", "exact_arguments_rate", "success_rate",
        "repair_attempts", "outcomes"
      ],
      "properties": {
        "attempts": {"type": "integer", "minimum": 1},
        "valid_calls": {"type": "integer", "minimum": 0},
        "correct_tools": {"type": "integer", "minimum": 0},
        "exact_arguments": {"type": "integer", "minimum": 0},
        "successes": {"type": "integer", "minimum": 0},
        "valid_call_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "correct_tool_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "exact_arguments_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "repair_attempts": {"type": "integer", "minimum": 0},
        "outcomes": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "determinism": {"$ref": "#/$defs/determinism"},
        "external_oracle": {"$ref": "#/$defs/externalOracleRollup"},
        "families": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/familyQuality"}
        }
      }
    },
    "final_ownership": {
      "$ref": "agentic-coding-quality-records.schema.json#/$defs/finalOwnership"
    },
    "turn_records_sha256": {"$ref": "#/$defs/sha256"},
    "turn_records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "agentic-coding-quality-records.schema.json#/$defs/turnRecord"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated", "expected_repetitions", "task_rows", "passed",
        "mismatches", "incomplete_rows"
      ],
      "properties": {
        "evaluated": {"const": true},
        "expected_repetitions": {"type": "integer", "minimum": 2},
        "task_rows": {"type": "integer", "minimum": 1},
        "passed": {"type": "boolean"},
        "mismatches": {"type": "array", "items": {"type": "object"}},
        "incomplete_rows": {"type": "array", "items": {"type": "object"}}
      }
    },
    "externalOracleRollup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts", "passes", "pass_rate", "patch_attempts", "patch_successes",
        "patch_success_rate", "test_attempts", "test_successes", "test_success_rate"
      ],
      "properties": {
        "attempts": {"type": "integer", "minimum": 0},
        "passes": {"type": "integer", "minimum": 0},
        "pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "patch_attempts": {"type": "integer", "minimum": 0},
        "patch_successes": {"type": "integer", "minimum": 0},
        "patch_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "test_attempts": {"type": "integer", "minimum": 0},
        "test_successes": {"type": "integer", "minimum": 0},
        "test_success_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "familyQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts", "valid_calls", "correct_tools", "exact_arguments", "successes",
        "valid_call_rate", "correct_tool_rate", "exact_arguments_rate", "success_rate",
        "repair_attempts", "outcomes", "external_oracle"
      ],
      "properties": {
        "attempts": {"type": "integer", "minimum": 1},
        "valid_calls": {"type": "integer", "minimum": 0},
        "correct_tools": {"type": "integer", "minimum": 0},
        "exact_arguments": {"type": "integer", "minimum": 0},
        "successes": {"type": "integer", "minimum": 0},
        "valid_call_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "correct_tool_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "exact_arguments_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "repair_attempts": {"type": "integer", "minimum": 0},
        "outcomes": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "external_oracle": {"$ref": "#/$defs/externalOracleRollup"}
      }
    }
  }
}
