{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hipengine.local/schemas/exact-token-oracle.schema.json",
  "title": "hipEngine exact-token generation oracle",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "mode",
    "shape",
    "prompt_token_ids",
    "prompt_token_ids_sha256",
    "generated_token_ids",
    "generated_token_ids_sha256"
  ],
  "properties": {
    "kind": {
      "const": "hipengine_exact_token_oracle"
    },
    "schema_version": {
      "const": 1
    },
    "mode": {
      "enum": ["direct", "http"]
    },
    "shape": {
      "type": "object",
      "required": ["prompt_count", "prompt_length", "max_tokens"],
      "properties": {
        "prompt_count": {"type": "integer", "minimum": 1},
        "prompt_length": {"type": "integer", "minimum": 1},
        "max_tokens": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "prompt_token_ids": {
      "$ref": "#/$defs/tokenRows"
    },
    "generated_token_ids": {
      "$ref": "#/$defs/tokenRowsAllowEmpty"
    },
    "prompt_token_ids_sha256": {
      "$ref": "#/$defs/hashRows"
    },
    "generated_token_ids_sha256": {
      "$ref": "#/$defs/hashRows"
    }
  },
  "$defs": {
    "tokenId": {
      "type": "integer",
      "minimum": 0
    },
    "tokenRows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"$ref": "#/$defs/tokenId"}
      }
    },
    "tokenRowsAllowEmpty": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "items": {"$ref": "#/$defs/tokenId"}
      }
    },
    "hashRows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "additionalProperties": true
}
