{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hipEngine execution-profile variant manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "execution_profile",
    "backend",
    "model",
    "quant",
    "kv_policy",
    "graph_policy",
    "selections"
  ],
  "properties": {
    "kind": {"const": "hipengine_execution_profile_manifest"},
    "schema_version": {"const": 1},
    "execution_profile": {
      "enum": ["strict", "production", "batch_invariant"]
    },
    "backend": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "quant": {"type": "string", "minLength": 1},
    "kv_policy": {"type": "string", "minLength": 1},
    "graph_policy": {"type": "string", "minLength": 1},
    "selections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer",
          "scope",
          "selected_variant",
          "strict_fallback_variant",
          "evidence_artifact"
        ],
        "properties": {
          "layer": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "selected_variant": {"type": "string", "minLength": 1},
          "strict_fallback_variant": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "evidence_artifact": {
            "type": ["string", "null"],
            "minLength": 1
          }
        }
      }
    }
  }
}
