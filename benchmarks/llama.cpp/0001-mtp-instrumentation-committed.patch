+static void common_speculative_mtp_draft_sample_trace_add(
+        llama_seq_id seq_id,
+        int32_t depth,
+        const llama_token_data_array * cur_p) {
+    if (!common_speculative_mtp_token_trace_enabled() || cur_p == nullptr || cur_p->data == nullptr) {
+        return;
+    }
+
+    common_speculative_mtp_draft_sample_trace trace;
+    trace.seq_id = seq_id;
+    trace.depth = depth;
+    const size_t limit = std::min<size_t>(10, cur_p->size);
+    trace.token_ids.reserve(limit);
+    trace.logits.reserve(limit);
+    trace.probs.reserve(limit);
+    for (size_t i = 0; i < limit; ++i) {
+        trace.token_ids.push_back(cur_p->data[i].id);
+        trace.logits.push_back(cur_p->data[i].logit);
+        trace.probs.push_back(cur_p->data[i].p);
+    }
+    common_speculative_mtp_draft_sample_traces.push_back(std::move(trace));
+}
