+void llama_context::extract_mtp_debug_tensors(const llm_graph_result * res) {
+    if (!llama_mtp_debug_tensor_trace_enabled() || res == nullptr || res->t_mtp_debug_tensors.empty()) {
+        return;
+    }
+
+    for (const auto & item : res->t_mtp_debug_tensors) {
+        const auto * tensor = item.second;
+        if (tensor == nullptr || tensor->type != GGML_TYPE_F32) {
+            continue;
+        }
+
+        const int64_t n = ggml_nelements(tensor);
+        if (n <= 0 || n > (int64_t) std::numeric_limits<int32_t>::max()) {
+            continue;
+        }
+
+        const size_t nbytes = ggml_nbytes(tensor);
+        std::vector<uint8_t> raw(nbytes);
+        ggml_backend_tensor_get(tensor, raw.data(), 0, raw.size());
+
+        const int token_dim = llama_mtp_debug_tensor_token_dim(item.first);
+        int32_t row_count = (int32_t) std::max<int64_t>(1, tensor->ne[token_dim]);
+        if (row_count <= 0 || n % row_count != 0 || token_dim < 0 || token_dim >= GGML_MAX_DIMS) {
+            row_count = 1;
+        }
+        const int32_t row_size = (int32_t) (n / row_count);
+
+        for (int32_t row_index = 0; row_index < row_count; ++row_index) {
+            std::vector<float> row;
+            row.reserve((size_t) row_size);
+            llama_mtp_debug_tensor_copy_token_row(tensor, raw, token_dim, row_index, row);
+            if ((int32_t) row.size() != row_size) {
+                continue;
+            }
+
+            double sum = 0.0;
+            double sum_sq = 0.0;
+            double min_v = std::numeric_limits<double>::infinity();
+            double max_v = -std::numeric_limits<double>::infinity();
+            for (int32_t j = 0; j < row_size; ++j) {
+                const double value = (double) row[(size_t) j];
+                sum += value;
+                sum_sq += value * value;
+                min_v = std::min(min_v, value);
+                max_v = std::max(max_v, value);
+            }
+
+            llama_mtp_debug_tensor_trace trace = {};
+            std::strncpy(trace.label, item.first.c_str(), sizeof(trace.label) - 1);
+            for (int i = 0; i < 4; ++i) {
+                trace.ne[i] = tensor->ne[i];
+            }
+            trace.type = (int32_t) tensor->type;
+            trace.size = row_size;
+            trace.row_index = row_index;
+            trace.row_count = row_count;
+            trace.fnv1a64 = llama_mtp_debug_fnv1a64(row.data(), trace.size);
+            trace.mean = sum / (double) row_size;
+            trace.rms = std::sqrt(sum_sq / (double) row_size);
+            trace.min = min_v;
+            trace.max = max_v;
+
+            trace.first_count = std::min<int32_t>(8, trace.size);
+            for (int32_t i = 0; i < trace.first_count; ++i) {
+                trace.first8[i] = row[(size_t) i];
+            }
+
+            trace.last_count = std::min<int32_t>(8, trace.size);
+            for (int32_t i = 0; i < trace.last_count; ++i) {
+                trace.last8[i] = row[(size_t) (trace.size - trace.last_count + i)];
+            }
+
+            mtp_debug_tensor_traces.push_back(trace);
+        }
+    }
+}
