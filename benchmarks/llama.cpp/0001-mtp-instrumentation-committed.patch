+static json mtp_draft_sample_trace_json(
+        const std::vector<common_speculative_mtp_draft_sample_trace> & traces) {
+    json result = json::array();
+    for (const auto & trace : traces) {
+        json token_ids = json::array();
+        for (const auto id : trace.token_ids) {
+            token_ids.push_back(id);
+        }
+
+        json logits = json::array();
+        for (const auto logit : trace.logits) {
+            logits.push_back(logit);
+        }
+
+        json probs = json::array();
+        for (const auto prob : trace.probs) {
+            probs.push_back(prob);
+        }
+
+        json margins = json::array();
+        if (!trace.logits.empty()) {
+            const float best = trace.logits[0];
+            for (const auto logit : trace.logits) {
+                margins.push_back(best - logit);
+            }
+        }
+
+        result.push_back({
+            {"seq_id", trace.seq_id},
+            {"depth", trace.depth},
+            {"token_ids", token_ids},
+            {"logits", logits},
+            {"probs", probs},
+            {"logit_margins", margins},
+        });
+    }
+    return result;
+}
+
+static json mtp_hidden_state_trace_json(
