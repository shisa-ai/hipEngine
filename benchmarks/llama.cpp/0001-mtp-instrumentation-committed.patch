+static uint64_t common_speculative_mtp_fnv1a64(const float * row, int32_t n) {
+    const auto * bytes = reinterpret_cast<const unsigned char *>(row);
+    const size_t n_bytes = (size_t) n * sizeof(float);
+    uint64_t hash = 1469598103934665603ULL;
+    for (size_t i = 0; i < n_bytes; ++i) {
+        hash ^= (uint64_t) bytes[i];
+        hash *= 1099511628211ULL;
+    }
+    return hash;
+}
+
+static void common_speculative_mtp_hidden_state_trace_add_row(
+        const char * label,
+        llama_seq_id seq_id,
+        int32_t depth,
+        llama_token token_id,
+        llama_pos position,
+        const float * row,
+        int32_t n,
+        int32_t row_index,
+        int32_t row_count) {
+    if (!common_speculative_mtp_token_trace_enabled() || row == nullptr || n <= 0) {
+        return;
+    }
+
+    double sum = 0.0;
+    double sum_sq = 0.0;
+    double min_v = std::numeric_limits<double>::infinity();
+    double max_v = -std::numeric_limits<double>::infinity();
+    for (int32_t i = 0; i < n; ++i) {
+        const double value = (double) row[i];
+        sum += value;
+        sum_sq += value * value;
+        min_v = std::min(min_v, value);
+        max_v = std::max(max_v, value);
+    }
+
+    common_speculative_mtp_hidden_state_trace trace;
+    trace.label = label;
+    trace.seq_id = seq_id;
+    trace.depth = depth;
+    trace.token_id = token_id;
+    trace.position = position;
+    trace.size = n;
+    trace.shape = {n};
+    trace.row_index = row_index;
+    trace.row_count = row_count;
+    trace.fnv1a64 = common_speculative_mtp_fnv1a64(row, n);
+    trace.mean = sum / (double) n;
+    trace.rms = std::sqrt(sum_sq / (double) n);
+    trace.min = min_v;
+    trace.max = max_v;
+
+    const int32_t first_count = std::min<int32_t>(8, n);
+    trace.first8.reserve(first_count);
+    for (int32_t i = 0; i < first_count; ++i) {
+        trace.first8.push_back(row[i]);
+    }
+
+    const int32_t last_count = std::min<int32_t>(8, n);
+    trace.last8.reserve(last_count);
+    for (int32_t i = n - last_count; i < n; ++i) {
+        trace.last8.push_back(row[i]);
+    }
+
+    common_speculative_mtp_hidden_state_traces.push_back(std::move(trace));
+}
+
+static void common_speculative_mtp_hidden_state_trace_add(
+        const char * label,
+        llama_seq_id seq_id,
+        int32_t depth,
+        llama_token token_id,
+        llama_pos position,
+        const float * row,
+        int32_t n) {
+    common_speculative_mtp_hidden_state_trace_add_row(
+            label, seq_id, depth, token_id, position, row, n, -1, 1);
+}
