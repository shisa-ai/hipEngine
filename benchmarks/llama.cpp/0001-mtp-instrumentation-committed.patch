+    json result = json::array();
+    for (const auto & trace : traces) {
+        json first8 = json::array();
+        for (const auto value : trace.first8) {
+            first8.push_back(value);
+        }
+
+        json last8 = json::array();
+        for (const auto value : trace.last8) {
+            last8.push_back(value);
+        }
+
+        json shape = json::array();
+        for (const auto value : trace.shape) {
+            shape.push_back(value);
+        }
+
+        result.push_back({
+            {"label", trace.label},
+            {"seq_id", trace.seq_id},
+            {"depth", trace.depth},
+            {"token_id", trace.token_id},
+            {"position", trace.position},
+            {"size", trace.size},
+            {"shape", shape},
+            {"row_index", trace.row_index},
+            {"row_count", trace.row_count},
+            {"fnv1a64", trace.fnv1a64},
+            {"mean", trace.mean},
+            {"rms", trace.rms},
+            {"min", trace.min},
+            {"max", trace.max},
+            {"first8", first8},
+            {"last8", last8},
+        });
+    }
+    return result;
+}
+
+struct mtp_roctx_api {
+    using range_push_fn = int (*)(const char *);
+    using range_pop_fn  = int (*)();
+
+    void * handle = nullptr;
+    range_push_fn range_push = nullptr;
+    range_pop_fn  range_pop  = nullptr;
+    bool tried = false;
+};
+
+static bool mtp_roctx_enabled() {
+    const char * enabled = std::getenv("LLAMA_MTP_ROCTX");
+    return enabled && enabled[0] && std::strcmp(enabled, "0") != 0;
+}
+
+static mtp_roctx_api & mtp_roctx_api_get() {
+    static mtp_roctx_api api;
+    if (api.tried) {
+        return api;
+    }
+    api.tried = true;
+
+    if (!mtp_roctx_enabled()) {
+        return api;
+    }
+
+    const char * libs[] = { "librocprofiler-sdk-roctx.so", "libroctx64.so" };
+    for (const char * lib : libs) {
+        api.handle = dlopen(lib, RTLD_LAZY | RTLD_LOCAL);
+        if (api.handle != nullptr) {
+            break;
+        }
+    }
+    if (api.handle == nullptr) {
+        return api;
+    }
+
+    api.range_push = reinterpret_cast<mtp_roctx_api::range_push_fn>(dlsym(api.handle, "roctxRangePushA"));
+    api.range_pop  = reinterpret_cast<mtp_roctx_api::range_pop_fn >(dlsym(api.handle, "roctxRangePop"));
+    if (api.range_push == nullptr || api.range_pop == nullptr) {
+        dlclose(api.handle);
+        api.handle = nullptr;
+        api.range_push = nullptr;
+        api.range_pop = nullptr;
+    }
+    return api;
+}
+
+static void mtp_roctx_push(const char * name) {
+    auto & api = mtp_roctx_api_get();
+    if (api.range_push != nullptr && api.range_pop != nullptr) {
+        api.range_push(name);
+    }
+}
+
+static void mtp_roctx_pop() {
+    auto & api = mtp_roctx_api_get();
+    if (api.range_push != nullptr && api.range_pop != nullptr) {
+        api.range_pop();
+    }
+}
+
+struct mtp_stage_trace {
+    int64_t cycle_wall_t0_us = 0;
+    int64_t cycle = 0;
+    int slot_id = -1;
+    int task_id = -1;
+    std::map<std::string, double> stage_timings_ms;
