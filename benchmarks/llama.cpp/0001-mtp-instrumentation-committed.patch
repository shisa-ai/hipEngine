+static uint64_t llama_mtp_debug_fnv1a64(const float * row, int32_t n) {
+    const auto * bytes = reinterpret_cast<const unsigned char *>(row);
+    const size_t n_bytes = (size_t) n * sizeof(float);
+    uint64_t hash = 1469598103934665603ULL;
+    for (size_t i = 0; i < n_bytes; ++i) {
+        hash ^= (uint64_t) bytes[i];
+        hash *= 1099511628211ULL;
+    }
+    return hash;
+}
+
+static int llama_mtp_debug_tensor_token_dim(const std::string & label) {
+    if (label == "mtp_Qcur_normed" ||
+            label == "mtp_Qcur_rope" ||
+            label == "mtp_Kcur_normed" ||
+            label == "mtp_Kcur_rope" ||
+            label == "mtp_Vcur") {
+        return 2;
+    }
+    return 1;
+}
+
+static void llama_mtp_debug_tensor_copy_token_row(
+        const ggml_tensor * tensor,
+        const std::vector<uint8_t> & raw,
+        int token_dim,
+        int32_t row_index,
+        std::vector<float> & row) {
+    row.clear();
+    for (int64_t i3 = 0; i3 < tensor->ne[3]; ++i3) {
+        for (int64_t i2 = 0; i2 < tensor->ne[2]; ++i2) {
+            if (token_dim == 2 && i2 != row_index) {
+                continue;
+            }
+            for (int64_t i1 = 0; i1 < tensor->ne[1]; ++i1) {
+                if (token_dim == 1 && i1 != row_index) {
+                    continue;
+                }
+                for (int64_t i0 = 0; i0 < tensor->ne[0]; ++i0) {
+                    const size_t offset =
+                        (size_t) i0 * tensor->nb[0] +
+                        (size_t) i1 * tensor->nb[1] +
+                        (size_t) i2 * tensor->nb[2] +
+                        (size_t) i3 * tensor->nb[3];
+                    float value = 0.0f;
+                    std::memcpy(&value, raw.data() + offset, sizeof(float));
+                    row.push_back(value);
+                }
+            }
+        }
+    }
+}
