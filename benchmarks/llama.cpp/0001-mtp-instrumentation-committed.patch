+std::vector<common_speculative_mtp_hidden_state_trace> common_speculative_mtp_hidden_state_trace_take() {
+    std::vector<common_speculative_mtp_hidden_state_trace> result;
+    result.swap(common_speculative_mtp_hidden_state_traces);
