+static void mtp_stage_add_token_trace(
+        json & event,
+        const llama_tokens & draft_tokens,
+        const llama_tokens & sampled_tokens,
+        size_t n_accepted_draft_tokens,
+        bool emitted_visible_tokens) {
+    if (!mtp_token_trace_enabled()) {
+        return;
+    }
+
+    event["draft_token_ids"] = mtp_tokens_json(draft_tokens);
+    event["sampled_token_ids"] = mtp_tokens_json(sampled_tokens);
+    event["accepted_token_ids"] = mtp_tokens_json_range(sampled_tokens, 0, n_accepted_draft_tokens);
+    event["output_token_ids"] = emitted_visible_tokens ? mtp_tokens_json(sampled_tokens) : json::array();
+    event["bonus_token_id"] = sampled_tokens.empty() ? json(nullptr) : json(sampled_tokens.back());
+    event["rejected_draft_token_id"] = n_accepted_draft_tokens < draft_tokens.size()
+        ? json(draft_tokens[n_accepted_draft_tokens])
