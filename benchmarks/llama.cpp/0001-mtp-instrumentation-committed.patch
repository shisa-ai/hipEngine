+static const char * common_speculative_mtp_tensor_trace_label(const char * label) {
+    if (std::strcmp(label, "mtp_tok_embd") == 0) {
+        return "draft_stage_token_embed";
+    }
+    if (std::strcmp(label, "mtp_enorm") == 0) {
+        return "draft_stage_e_norm";
+    }
+    if (std::strcmp(label, "mtp_hnorm") == 0) {
+        return "draft_stage_h_norm";
+    }
+    if (std::strcmp(label, "mtp_eh_proj") == 0) {
+        return "draft_stage_projected";
+    }
+    if (std::strcmp(label, "mtp_attn_norm") == 0) {
+        return "draft_stage_attn_normed";
+    }
+    if (std::strcmp(label, "mtp_Qcur_normed") == 0) {
+        return "llama_stage_query_normed";
+    }
+    if (std::strcmp(label, "mtp_Qcur_rope") == 0) {
+        return "draft_stage_query_rope";
+    }
+    if (std::strcmp(label, "mtp_Kcur_normed") == 0) {
+        return "llama_stage_key_normed";
+    }
+    if (std::strcmp(label, "mtp_Kcur_rope") == 0) {
+        return "draft_stage_key_cur_rope";
+    }
+    if (std::strcmp(label, "mtp_Vcur") == 0) {
+        return "draft_stage_value_cur";
+    }
+    if (std::strcmp(label, "mtp_attn_pregate") == 0) {
+        return "draft_stage_attn_pregate";
+    }
+    if (std::strcmp(label, "mtp_attn_out") == 0) {
+        return "draft_stage_attn_out";
+    }
+    if (std::strcmp(label, "mtp_attn_residual") == 0) {
+        return "draft_stage_attn_residual";
+    }
+    if (std::strcmp(label, "mtp_attn_post_norm") == 0) {
+        return "draft_stage_attn_post_norm";
+    }
+    if (std::strcmp(label, "mtp_ffn_out") == 0) {
+        return "draft_stage_ffn_out";
+    }
+    if (std::strcmp(label, "mtp_post_ffn") == 0) {
+        return "llama_stage_post_ffn";
+    }
+    if (std::strcmp(label, "h_nextn") == 0) {
+        return "llama_stage_h_nextn";
+    }
+    return label;
+}
