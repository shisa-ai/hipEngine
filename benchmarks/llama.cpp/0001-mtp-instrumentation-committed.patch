+    std::vector<common_speculative_mtp_hidden_state_trace> hidden_state_traces;
+};
+
+static void mtp_stage_add(mtp_stage_trace & trace, const char * name, int64_t dt_us) {
+    if (dt_us < 0) {
+        return;
+    }
+    trace.stage_timings_ms[name] += (double) dt_us / 1000.0;
+}
+
+static void mtp_stage_add_ms(mtp_stage_trace & trace, const std::string & name, double ms) {
+    if (ms < 0.0) {
+        return;
+    }
+    trace.stage_timings_ms[name] += ms;
+}
+
+static void mtp_stage_merge(mtp_stage_trace & trace, const std::map<std::string, double> & stages) {
+    for (const auto & item : stages) {
+        mtp_stage_add_ms(trace, item.first, item.second);
+    }
+}
+
+static void mtp_stage_write_json(const json & record) {
+    const char * path = mtp_stage_timings_path();
+    if (path == nullptr) {
+        return;
+    }
+
+    static std::mutex mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+
+    std::ofstream file(path, std::ios::app);
+    if (!file) {
+        return;
+    }
+    file << record.dump() << '\n';
+}
