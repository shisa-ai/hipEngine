+static bool common_speculative_mtp_stage_trace_enabled() {
+    const char * path = std::getenv("LLAMA_MTP_STAGE_TIMINGS");
+    return path && path[0];
+}
+
+static bool common_speculative_mtp_token_trace_enabled() {
+    const char * enabled = std::getenv("LLAMA_MTP_TOKEN_TRACE");
+    return enabled && enabled[0] && std::strcmp(enabled, "0") != 0;
+}
+
+struct common_speculative_mtp_roctx_api {
+    using range_push_fn = int (*)(const char *);
+    using range_pop_fn  = int (*)();
+
+    void * handle = nullptr;
+    range_push_fn range_push = nullptr;
+    range_pop_fn  range_pop  = nullptr;
+    bool tried = false;
+};
+
+static bool common_speculative_mtp_roctx_enabled() {
+    const char * enabled = std::getenv("LLAMA_MTP_ROCTX");
+    return enabled && enabled[0] && std::strcmp(enabled, "0") != 0;
+}
+
+static common_speculative_mtp_roctx_api & common_speculative_mtp_roctx_api_get() {
+    static common_speculative_mtp_roctx_api api;
+    if (api.tried) {
+        return api;
+    }
+    api.tried = true;
+
+    if (!common_speculative_mtp_roctx_enabled()) {
+        return api;
+    }
+
+    const char * libs[] = { "librocprofiler-sdk-roctx.so", "libroctx64.so" };
+    for (const char * lib : libs) {
+        api.handle = dlopen(lib, RTLD_LAZY | RTLD_LOCAL);
+        if (api.handle != nullptr) {
+            break;
+        }
+    }
+    if (api.handle == nullptr) {
+        return api;
+    }
+
+    api.range_push = reinterpret_cast<common_speculative_mtp_roctx_api::range_push_fn>(dlsym(api.handle, "roctxRangePushA"));
+    api.range_pop  = reinterpret_cast<common_speculative_mtp_roctx_api::range_pop_fn >(dlsym(api.handle, "roctxRangePop"));
+    if (api.range_push == nullptr || api.range_pop == nullptr) {
+        dlclose(api.handle);
+        api.handle = nullptr;
+        api.range_push = nullptr;
+        api.range_pop = nullptr;
+    }
+    return api;
+}
+
+static void common_speculative_mtp_roctx_push(const char * name) {
+    auto & api = common_speculative_mtp_roctx_api_get();
+    if (api.range_push != nullptr && api.range_pop != nullptr) {
+        api.range_push(name);
+    }
+}
+
+static void common_speculative_mtp_roctx_pop() {
+    auto & api = common_speculative_mtp_roctx_api_get();
+    if (api.range_push != nullptr && api.range_pop != nullptr) {
+        api.range_pop();
+    }
+}
