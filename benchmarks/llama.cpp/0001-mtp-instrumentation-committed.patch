+static json mtp_tokens_json_range(const llama_tokens & tokens, size_t begin, size_t end) {
+    json result = json::array();
+    end = std::min(end, tokens.size());
+    for (size_t i = begin; i < end; ++i) {
+        result.push_back(tokens[i]);
+    }
+    return result;
