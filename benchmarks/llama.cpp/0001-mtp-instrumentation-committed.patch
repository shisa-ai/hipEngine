+static void common_speculative_mtp_tensor_trace_drain(
+        llama_context * ctx,
+        llama_seq_id seq_id,
+        int32_t depth,
+        llama_token token_id,
+        llama_pos position) {
+    if (ctx == nullptr) {
+        return;
+    }
+
+    const size_t n_traces = llama_mtp_debug_tensor_trace_count(ctx);
+    const llama_mtp_debug_tensor_trace * traces = llama_mtp_debug_tensor_trace_data(ctx);
+    if (!common_speculative_mtp_token_trace_enabled() || traces == nullptr || n_traces == 0) {
+        llama_mtp_debug_tensor_trace_clear(ctx);
+        return;
+    }
+
+    for (size_t i = 0; i < n_traces; ++i) {
+        const auto & src = traces[i];
+        common_speculative_mtp_hidden_state_trace trace;
+        trace.label = common_speculative_mtp_tensor_trace_label(src.label);
+        trace.seq_id = seq_id;
+        trace.depth = depth;
+        trace.token_id = token_id;
+        trace.position = position;
+        trace.size = src.size;
+        trace.shape.assign(src.ne, src.ne + 4);
+        trace.row_index = src.row_index;
+        trace.row_count = src.row_count;
+        trace.fnv1a64 = src.fnv1a64;
+        trace.mean = src.mean;
+        trace.rms = src.rms;
+        trace.min = src.min;
+        trace.max = src.max;
+
+        trace.first8.reserve(src.first_count);
+        for (int32_t j = 0; j < src.first_count; ++j) {
+            trace.first8.push_back(src.first8[j]);
+        }
+
+        trace.last8.reserve(src.last_count);
+        for (int32_t j = 0; j < src.last_count; ++j) {
+            trace.last8.push_back(src.last8[j]);
+        }
+
+        common_speculative_mtp_hidden_state_traces.push_back(std::move(trace));
+    }
+
+    llama_mtp_debug_tensor_trace_clear(ctx);
+}
+
+static void common_speculative_mtp_tensor_trace_drain_batch(
+        llama_context * ctx,
+        const llama_batch & batch,
+        int32_t depth) {
+    if (ctx == nullptr) {
+        return;
+    }
+
+    const size_t n_traces = llama_mtp_debug_tensor_trace_count(ctx);
+    const llama_mtp_debug_tensor_trace * traces = llama_mtp_debug_tensor_trace_data(ctx);
+    if (!common_speculative_mtp_token_trace_enabled() || traces == nullptr || n_traces == 0) {
+        llama_mtp_debug_tensor_trace_clear(ctx);
+        return;
+    }
+
+    for (size_t i = 0; i < n_traces; ++i) {
+        const auto & src = traces[i];
+        int32_t batch_index = src.row_index;
+        if (src.row_count != batch.n_tokens || batch_index < 0 || batch_index >= batch.n_tokens) {
+            batch_index = batch.n_tokens == 1 ? 0 : -1;
+        }
+
+        llama_seq_id seq_id = -1;
+        llama_token token_id = LLAMA_TOKEN_NULL;
+        llama_pos position = 0;
+        if (batch_index >= 0) {
+            seq_id = batch.seq_id[batch_index][0];
+            token_id = batch.token[batch_index];
+            position = batch.pos[batch_index];
+        }
+
+        common_speculative_mtp_hidden_state_trace trace;
+        trace.label = common_speculative_mtp_tensor_trace_label(src.label);
+        trace.seq_id = seq_id;
+        trace.depth = depth;
+        trace.token_id = token_id;
+        trace.position = position;
+        trace.size = src.size;
+        trace.shape.assign(src.ne, src.ne + 4);
+        trace.row_index = src.row_index;
+        trace.row_count = src.row_count;
+        trace.fnv1a64 = src.fnv1a64;
+        trace.mean = src.mean;
+        trace.rms = src.rms;
+        trace.min = src.min;
+        trace.max = src.max;
+
+        trace.first8.reserve(src.first_count);
+        for (int32_t j = 0; j < src.first_count; ++j) {
+            trace.first8.push_back(src.first8[j]);
+        }
+
+        trace.last8.reserve(src.last_count);
+        for (int32_t j = 0; j < src.last_count; ++j) {
+            trace.last8.push_back(src.last8[j]);
+        }
+
+        common_speculative_mtp_hidden_state_traces.push_back(std::move(trace));
+    }
+
+    llama_mtp_debug_tensor_trace_clear(ctx);
+}
+
+void common_speculative_mtp_stage_trace_reset() {
+    common_speculative_mtp_stage_timings_ms.clear();
+    common_speculative_mtp_draft_sample_traces.clear();
+    common_speculative_mtp_hidden_state_traces.clear();
+}
