# MEASUREMENT ONLY: return raw content for content-only completions.
#
# Laguna can emit byte sequences that the generic PEG content parser rejects,
# causing /completion to return HTTP 500 after generation has completed. For
# raw-token timing, --skip-chat-parsing means response content is exactly the
# generated text, so bypass the redundant PEG round-trip for that one format.
# This runs after generation and does not alter model execution or native
# prompt_n/predicted_n/predicted_ms ownership.
diff --git a/common/chat.cpp b/common/chat.cpp
--- a/common/chat.cpp
+++ b/common/chat.cpp
@@ -2944,6 +2944,13 @@
 common_chat_msg common_chat_parse(const std::string &               input,
                                   bool                              is_partial,
                                   const common_chat_parser_params & params) {
+    if (params.format == COMMON_CHAT_FORMAT_CONTENT_ONLY) {
+        common_chat_msg msg;
+        msg.role    = "assistant";
+        msg.content = input;
+        return msg;
+    }
+
     return common_chat_peg_parse(params.parser, input, is_partial, params);
 }
 
