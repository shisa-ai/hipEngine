+    if (tensor == nullptr) {
+        return false;
+    }
+    if (tensor->type != GGML_TYPE_F32 &&
+            tensor->type != GGML_TYPE_F16 &&
+            tensor->type != GGML_TYPE_BF16) {
+        return false;
+    }
+
+    const size_t nbytes = ggml_nbytes(tensor);
+    if (nbytes == 0) {
+        return false;
+    }
+    raw.resize(nbytes);
+    ggml_backend_tensor_get(tensor, raw.data(), 0, raw.size());
+    return true;
+}
