+                            ++visible_count;
+                        }
+                    }
+
+                    double exp_sum = 0.0;
+                    if (std::isfinite(max_score)) {
+                        for (int64_t row = 0; row < cache_tokens; ++row) {
+                            const float score = scores[(size_t) row];
+                            if (!std::isfinite(score)) {
