+void llama_context::extract_mtp_debug_attention(const llm_graph_result * res) {
+    if (!llama_mtp_debug_attention_trace_enabled() || res == nullptr || res->t_mtp_debug_attention.empty()) {
+        return;
+    }
+
+    const llama_ubatch & ubatch = res->get_params().ubatch;
+    auto fill_row_metadata = [&](llama_mtp_debug_attention_trace & trace, int64_t row_index) {
+        if (row_index < 0 || row_index >= ubatch.n_tokens ||
+                ubatch.token == nullptr ||
+                ubatch.pos == nullptr ||
+                ubatch.n_seq_id == nullptr ||
+                ubatch.seq_id == nullptr ||
+                ubatch.n_seq_id[row_index] <= 0 ||
+                ubatch.seq_id[row_index] == nullptr) {
+            trace.has_row_metadata = 0;
+            trace.seq_id = -1;
+            trace.token_id = LLAMA_TOKEN_NULL;
+            trace.position = 0;
+            return;
+        }
+        trace.has_row_metadata = 1;
+        trace.seq_id = ubatch.seq_id[row_index][0];
+        trace.token_id = ubatch.token[row_index];
+        trace.position = ubatch.pos[row_index];
+    };
+
+    for (const auto & item : res->t_mtp_debug_attention) {
+        auto push_shape_only = [&]() {
+            llama_mtp_debug_attention_trace trace = {};
+            std::strncpy(trace.label, item.label.c_str(), sizeof(trace.label) - 1);
+            fill_row_metadata(trace, -1);
+            for (int i = 0; i < 4; ++i) {
+                trace.q_ne[i]    = item.q    ? item.q->ne[i]    : 0;
+                trace.k_ne[i]    = item.k    ? item.k->ne[i]    : 0;
+                trace.v_ne[i]    = item.v    ? item.v->ne[i]    : 0;
+                trace.mask_ne[i] = item.mask ? item.mask->ne[i] : 0;
+                trace.out_ne[i]  = item.out  ? item.out->ne[i]  : 0;
+            }
+            trace.q_type         = item.q    ? (int32_t) item.q->type    : -1;
+            trace.k_type         = item.k    ? (int32_t) item.k->type    : -1;
+            trace.v_type         = item.v    ? (int32_t) item.v->type    : -1;
+            trace.mask_type      = item.mask ? (int32_t) item.mask->type : -1;
+            trace.out_type       = item.out  ? (int32_t) item.out->type  : -1;
+            trace.use_flash_attn = item.use_flash_attn ? 1 : 0;
+            trace.row_index      = -1;
+            trace.row_count      = 0;
+            trace.scale          = item.scale;
+            mtp_debug_attention_traces.push_back(trace);
+        };
+
+        std::vector<uint8_t> q_raw;
+        std::vector<uint8_t> k_raw;
+        std::vector<uint8_t> v_raw;
+        std::vector<uint8_t> mask_raw;
+        std::vector<uint8_t> out_raw;
+        if (!llama_mtp_debug_tensor_copy_raw(item.q, q_raw) ||
+                !llama_mtp_debug_tensor_copy_raw(item.k, k_raw) ||
+                !llama_mtp_debug_tensor_copy_raw(item.v, v_raw) ||
+                !llama_mtp_debug_tensor_copy_raw(item.mask, mask_raw) ||
+                !llama_mtp_debug_tensor_copy_raw(item.out, out_raw)) {
+            push_shape_only();
+            continue;
+        }
+
+        const int64_t head_dim     = item.q->ne[0];
+        const int64_t query_tokens = item.q->ne[1];
+        const int64_t heads        = item.q->ne[2];
+        const int64_t streams      = item.q->ne[3];
+        const int64_t cache_tokens = item.k->ne[1];
+        const int64_t kv_heads     = item.k->ne[2];
+        if (head_dim <= 0 || query_tokens <= 0 || heads <= 0 ||
+                streams <= 0 || cache_tokens <= 0 || kv_heads <= 0 ||
+                heads % kv_heads != 0 || item.k->ne[0] != head_dim ||
+                item.k->ne[3] != streams) {
+            push_shape_only();
+            continue;
+        }
+        if (item.mask->ne[0] < cache_tokens ||
+                item.mask->ne[1] < query_tokens ||
+                item.mask->ne[3] < streams) {
+            push_shape_only();
+            continue;
+        }
+        const bool v_dim_first =
+            item.v->ne[0] == head_dim && item.v->ne[1] == cache_tokens &&
+            item.v->ne[2] == kv_heads && item.v->ne[3] == streams;
+        const bool v_dim_second =
+            item.v->ne[0] == cache_tokens && item.v->ne[1] == head_dim &&
+            item.v->ne[2] == kv_heads && item.v->ne[3] == streams;
+        if (!v_dim_first && !v_dim_second) {
