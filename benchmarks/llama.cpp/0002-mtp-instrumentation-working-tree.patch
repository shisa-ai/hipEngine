+                    auto add_probe_row = [&](int64_t row) {
+                        if (row < 0 || row >= cache_tokens ||
+                                head.row_probe_count >= LLAMA_MTP_DEBUG_ATTENTION_ROW_PROBES) {
+                            return;
+                        }
+                        for (int32_t i = 0; i < head.row_probe_count; ++i) {
+                            if (head.row_probes[i].row == row) {
+                                return;
+                            }
+                        }
+                        auto & probe = head.row_probes[head.row_probe_count++];
+                        probe.row = (int32_t) row;
+                        probe.score = scores[(size_t) row];
+                        probe.weight = weights[(size_t) row];
+                        probe.mask = masks[(size_t) row];
+                        probe.first_count = first_count;
+                        for (int32_t dim = 0; dim < first_count; ++dim) {
+                            float kv = 0.0f;
+                            if (llama_mtp_debug_tensor_get_f32(item.k, k_raw, dim, row, kh, stream, kv)) {
+                                probe.key_first[dim] = kv;
+                            }
+                            float vv = 0.0f;
+                            bool ok = false;
+                            if (v_dim_first) {
+                                ok = llama_mtp_debug_tensor_get_f32(item.v, v_raw, dim, row, kh, stream, vv);
+                            } else {
+                                ok = llama_mtp_debug_tensor_get_f32(item.v, v_raw, row, dim, kh, stream, vv);
+                            }
+                            if (ok) {
+                                probe.value_first[dim] = vv;
+                            }
+                        }
+                    };
+
+                    add_probe_row(0);
+                    add_probe_row(1);
+                    add_probe_row(2);
+                    add_probe_row(cache_tokens - 2);
+                    add_probe_row(cache_tokens - 1);
+                    for (int32_t top = 0; top < head.top_count; ++top) {
+                        int64_t best_row = -1;
+                        float best_weight = -1.0f;
+                        for (int64_t row = 0; row < cache_tokens; ++row) {
+                            bool used = false;
+                            for (int32_t prev = 0; prev < top; ++prev) {
+                                if (head.top_rows[prev] == row) {
+                                    used = true;
+                                    break;
+                                }
+                            }
+                            if (!used && weights[(size_t) row] > best_weight) {
+                                best_weight = weights[(size_t) row];
+                                best_row = row;
+                            }
+                        }
+                        if (best_row >= 0) {
+                            head.top_rows[top] = (int32_t) best_row;
+                            head.top_scores[top] = scores[(size_t) best_row];
+                            head.top_weights[top] = weights[(size_t) best_row];
+                            add_probe_row(best_row);
+                        }
+                    }
