+                llama_mtp_debug_attention_trace trace = {};
+                std::strncpy(trace.label, item.label.c_str(), sizeof(trace.label) - 1);
+                fill_row_metadata(trace, stream * query_tokens + query_row);
+                for (int i = 0; i < 4; ++i) {
+                    trace.q_ne[i]    = item.q->ne[i];
+                    trace.k_ne[i]    = item.k->ne[i];
+                    trace.v_ne[i]    = item.v->ne[i];
+                    trace.mask_ne[i] = item.mask->ne[i];
+                    trace.out_ne[i]  = item.out->ne[i];
+                }
+                trace.q_type         = (int32_t) item.q->type;
+                trace.k_type         = (int32_t) item.k->type;
+                trace.v_type         = (int32_t) item.v->type;
+                trace.mask_type      = (int32_t) item.mask->type;
+                trace.out_type       = (int32_t) item.out->type;
+                trace.use_flash_attn = item.use_flash_attn ? 1 : 0;
+                trace.row_index      = (int32_t) (stream * query_tokens + query_row);
+                trace.row_count      = (int32_t) row_count;
+                trace.cache_tokens   = (int32_t) cache_tokens;
+                trace.heads          = (int32_t) heads;
+                trace.kv_heads       = (int32_t) kv_heads;
+                trace.head_dim       = (int32_t) head_dim;
+                trace.scale          = item.scale;
+                trace.head_count     = (int32_t) std::min<int64_t>(heads, LLAMA_MTP_DEBUG_ATTENTION_MAX_HEADS);
+
+                double mae_sum = 0.0;
+                double max_abs_all = 0.0;
+                for (int32_t qh = 0; qh < trace.head_count; ++qh) {
+                    const int64_t kh = qh / kv_group;
+                    auto & head = trace.heads_trace[qh];
+                    head.query_head = qh;
+                    head.kv_head = (int32_t) kh;
+                    head.top_count = (int32_t) std::min<int64_t>(cache_tokens, LLAMA_MTP_DEBUG_ATTENTION_TOP_K);
+                    for (int i = 0; i < LLAMA_MTP_DEBUG_ATTENTION_TOP_K; ++i) {
+                        head.top_rows[i] = -1;
+                    }
+                    const int32_t first_count =
+                        (int32_t) std::min<int64_t>(head_dim, LLAMA_MTP_DEBUG_ATTENTION_FIRST_N);
+                    head.first_count = first_count;
+                    for (int32_t dim = 0; dim < first_count; ++dim) {
+                        float qv = 0.0f;
+                        if (llama_mtp_debug_tensor_get_f32(item.q, q_raw, dim, query_row, qh, stream, qv)) {
