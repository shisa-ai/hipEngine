+                        }
+                    }
+
+                    std::vector<float> scores((size_t) cache_tokens, -INFINITY);
+                    std::vector<float> weights((size_t) cache_tokens, 0.0f);
+                    std::vector<float> masks((size_t) cache_tokens, -INFINITY);
+                    float max_score = -INFINITY;
+                    int32_t visible_count = 0;
+                    for (int64_t row = 0; row < cache_tokens; ++row) {
+                        float mask = 0.0f;
+                        if (!llama_mtp_debug_tensor_get_f32(item.mask, mask_raw, row, query_row, 0, stream, mask)) {
+                            continue;
+                        }
+                        masks[(size_t) row] = mask;
+                        double dot = 0.0;
+                        bool ok = true;
+                        for (int64_t dim = 0; dim < head_dim; ++dim) {
+                            float qv = 0.0f;
+                            float kv = 0.0f;
+                            ok = ok &&
+                                llama_mtp_debug_tensor_get_f32(item.q, q_raw, dim, query_row, qh, stream, qv) &&
+                                llama_mtp_debug_tensor_get_f32(item.k, k_raw, dim, row, kh, stream, kv);
+                            if (!ok) {
