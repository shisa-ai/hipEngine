+static bool llama_mtp_debug_tensor_get_f32(
+        const ggml_tensor * tensor,
+        const std::vector<uint8_t> & raw,
+        int64_t i0,
+        int64_t i1,
+        int64_t i2,
+        int64_t i3,
+        float & value) {
+    if (tensor == nullptr ||
+            i0 < 0 || i0 >= tensor->ne[0] ||
+            i1 < 0 || i1 >= tensor->ne[1] ||
+            i2 < 0 || i2 >= tensor->ne[2] ||
+            i3 < 0 || i3 >= tensor->ne[3]) {
+        return false;
+    }
+
+    const size_t offset =
+        (size_t) i0 * tensor->nb[0] +
+        (size_t) i1 * tensor->nb[1] +
+        (size_t) i2 * tensor->nb[2] +
+        (size_t) i3 * tensor->nb[3];
+    const size_t type_size = ggml_type_size(tensor->type);
+    if (offset + type_size > raw.size()) {
+        return false;
+    }
+
+    if (tensor->type == GGML_TYPE_F32) {
+        std::memcpy(&value, raw.data() + offset, sizeof(value));
+        return true;
