+static int mtp_target_trace_top_k() {
+    const char * raw = std::getenv("LLAMA_MTP_TARGET_TRACE_TOP_K");
+    if (raw == nullptr || raw[0] == '\0') {
+        return 20;
+    }
+    return std::max(1, std::atoi(raw));
+}
+
+static llama_tokens mtp_target_trace_extra_candidates() {
+    llama_tokens result;
+    const char * raw = std::getenv("LLAMA_MTP_TARGET_TRACE_CANDIDATES");
+    if (raw == nullptr || raw[0] == '\0') {
+        return result;
+    }
+    const char * ptr = raw;
+    while (*ptr != '\0') {
+        char * end = nullptr;
+        const long value = std::strtol(ptr, &end, 10);
+        if (end == ptr) {
+            ++ptr;
+            continue;
+        }
+        if (value >= 0 && std::find(result.begin(), result.end(), (llama_token) value) == result.end()) {
+            result.push_back((llama_token) value);
+        }
+        ptr = end;
+    }
+    return result;
+}
+
+static json mtp_target_sample_trace_json(
+        llama_context * ctx,
+        const std::vector<int32_t> & idxs,
+        const llama_tokens & draft_tokens) {
+    json result = json::array();
+    if (!mtp_token_trace_enabled()) {
+        return result;
+    }
+
+    llama_tokens candidates = draft_tokens;
+    for (const auto token : mtp_target_trace_extra_candidates()) {
+        if (std::find(candidates.begin(), candidates.end(), token) == candidates.end()) {
+            candidates.push_back(token);
+        }
+    }
+
+    const int top_k = mtp_target_trace_top_k();
+    for (size_t row = 0; row < idxs.size(); ++row) {
+        std::vector<llama_token_data> cur = get_token_probabilities(ctx, idxs[row]);
+        const size_t top_n = std::min<size_t>(cur.size(), (size_t) top_k);
+        const float best = cur.empty() ? 0.0f : cur[0].logit;
+
+        json top = json::array();
+        for (size_t i = 0; i < top_n; ++i) {
+            top.push_back({
+                {"rank", (int) i + 1},
+                {"token_id", cur[i].id},
+                {"logit", cur[i].logit},
+                {"margin_from_top", best - cur[i].logit},
+                {"prob", cur[i].p},
+            });
+        }
+
+        json candidate_scores = json::array();
+        for (const auto token : candidates) {
+            json item = {
+                {"token_id", token},
+                {"in_vocab", false},
+            };
+            for (size_t i = 0; i < cur.size(); ++i) {
+                if (cur[i].id == token) {
+                    item = {
+                        {"token_id", token},
+                        {"in_vocab", true},
+                        {"rank", (int) i + 1},
+                        {"logit", cur[i].logit},
+                        {"margin_from_top", best - cur[i].logit},
+                        {"prob", cur[i].p},
+                    };
+                    break;
+                }
+            }
+            candidate_scores.push_back(item);
+        }
+
+        result.push_back({
+            {"row", (int) row},
+            {"i_batch", idxs[row]},
+            {"draft_token_at_depth", row < draft_tokens.size() ? json(draft_tokens[row]) : json(nullptr)},
+            {"top_k", top},
+            {"candidate_scores", candidate_scores},
+        });
+    }
+    return result;
+}
