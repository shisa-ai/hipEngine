+                        }
+                    }
+
+                    double diff_sum = 0.0;
+                    double max_abs = 0.0;
+                    for (int64_t dim = 0; dim < head_dim; ++dim) {
+                        double cpu = 0.0;
+                        bool ok = true;
+                        for (int64_t row = 0; row < cache_tokens; ++row) {
+                            float vv = 0.0f;
+                            if (v_dim_first) {
+                                ok = llama_mtp_debug_tensor_get_f32(item.v, v_raw, dim, row, kh, stream, vv);
+                            } else {
+                                ok = llama_mtp_debug_tensor_get_f32(item.v, v_raw, row, dim, kh, stream, vv);
+                            }
+                            if (!ok) {
+                                break;
+                            }
+                            cpu += (double) weights[(size_t) row] * (double) vv;
+                        }
+                        float device = 0.0f;
+                        ok = ok && llama_mtp_debug_tensor_get_f32(item.out, out_raw, dim, qh, query_row, stream, device);
+                        if (!ok) {
