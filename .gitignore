# hipEngine .gitignore
# See AGENTS.md "What Never Gets Committed" for the rationale.

# Python
__pycache__/
*.py[cod]
*.so
!hipengine/kernels/hip_gfx1100/attention/aotriton_runtime/**/*.so
!hipengine/kernels/hip_gfx1100/attention/aotriton_runtime/**/*.so.*
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build / JIT caches (though real build cache lives in ~/.cache/hipengine/)
build/
dist/
.eggs/

# Local resolver state; this library checkout does not track a uv lockfile.
uv.lock

# Model weights / fixtures that are too large to track
/models/
/weights/
*.safetensors
*.gguf
*.bin
# (exception: small test fixtures go under tests/fixtures/ and are tracked explicitly)

# Benchmark / profiler artifacts
*.rocprof
*.rocprofv3
rocprof_*/
profile_*/
bench_*.json
bench_*.csv
trace_*.csv

# Editor / env
.env
.env.*
.venv/
venv/
.vscode/
.idea/

# pi / agent harness state
.pi/
.multiloop/

# Local generated Worklog2 view
.worklog/

# OS
.DS_Store
Thumbs.db

third_party/

# Raw rocprofv3 dumps live beside the artifact that cites them but are never
# committed (see AGENTS.md "Never Committed"). Their digests go in the
# artifact; the CSVs stay local so the worktree does not read dirty forever.
benchmarks/results/**/role-trace/
benchmarks/results/**/*_kernel_trace.csv
benchmarks/results/**/*_agent_info.csv
